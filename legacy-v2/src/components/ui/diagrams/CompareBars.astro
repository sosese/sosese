---
// Comparaison de grandeurs (registre R3 de DESIGN.md) : deux ou trois valeurs de même unité,
// en longueurs proportionnelles. La valeur est toujours écrite — les barres sont décoratives.
type Bar = {
  label: string;
  value: number;
  display: string;
  note?: string;
  tone?: "muted" | "accent";
};

type Props = {
  bars: Bar[];
  max?: number;
  // Révèle les lignes une à une au défilement (libellé, puis barre, puis note), au lieu de la
  // croissance pilotée par `animation-timeline` de `.bar-grow` : les deux feraient double emploi.
  // Sans JS, sous mouvement réduit, ou sans le script : tout est là, à sa longueur finale.
  reveal?: boolean;
  class?: string;
};

const { bars, max, reveal = false, class: className } = Astro.props;
const echelle = max ?? Math.max(...bars.map((b) => b.value));
---

<ul class:list={["flex flex-col gap-4", className]} data-bars-revele={reveal ? "" : undefined}>
  {
    bars.map((bar) => (
      <li class="flex flex-col gap-2">
        <div
          class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1"
          data-revele={reveal ? "ligne" : undefined}
        >
          <span class="text-16 text-ink">{bar.label}</span>
          <span class:list={["font-mono text-21", bar.tone === "accent" ? "text-accent" : "text-ink"]}>
            {bar.display}
          </span>
        </div>
        <div aria-hidden="true" class="h-3 w-full rounded-full border border-border bg-bg">
          <span
            class:list={[
              "block h-full rounded-full",
              reveal ? null : "bar-grow",
              bar.tone === "accent" ? "bg-accent" : "bg-border-strong",
            ]}
            data-revele={reveal ? "barre" : undefined}
            style={`width: max(${((bar.value / echelle) * 100).toFixed(2)}%, calc(var(--space-unit) * 2))`}
          />
        </div>
        {bar.note && (
          <p class="text-14 text-ink-muted" data-revele={reveal ? "ligne" : undefined}>
            {bar.note}
          </p>
        )}
      </li>
    ))
  }
</ul>

<script>
  // Même contrat que la Méthode : les classes de masquage ne sont posées que par ce script, et
  // seulement hors mouvement réduit. Sans JS, rien n'est masqué. Une seule lecture, au premier passage.
  (function () {
    var listes = document.querySelectorAll("[data-bars-revele]");
    if (!listes.length || !("IntersectionObserver" in window)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    var PAS = 260; // entre deux éléments d'une même comparaison, comme dans la Méthode

    Array.prototype.forEach.call(listes, function (liste) {
      var elements = Array.prototype.slice.call(liste.querySelectorAll("[data-revele]"));
      elements.forEach(function (el) {
        el.classList.add("revele-cache");
      });

      var observateur = new IntersectionObserver(
        function (entrees) {
          if (!entrees[0].isIntersecting) return;
          observateur.disconnect();
          elements.forEach(function (el, i) {
            window.setTimeout(function () {
              el.classList.remove("revele-cache");
            }, (i + 1) * PAS);
          });
        },
        { threshold: 0.25 },
      );
      observateur.observe(liste);
    });
  })();
</script>
