---
// Mockup animé de « Sous le capot » (registre R2), en vis-à-vis du terminal : la même mission — un
// devis préparé depuis le catalogue — vue côté personne, puis côté machine. Hero jusqu'au
// 2026-09-17, « L'offre » jusqu'au 2026-09-19.
// Cinq tâches jouées à la suite, en boucle, pour montrer que le
// connecteur n'est pas un outil à devis : il lit les règles déjà présentes dans les logiciels de
// l'entreprise, rend la forme qu'appelle le besoin (tableau, fiche, message, agenda, classement) et
// se termine par une action réellement faite — après accord, sauf en lecture seule.
// Scénarios inventés : voir src/config/demo-hero.ts.
//
// Contrat, identique à celui du terminal et de la démo du cas client :
// - l'état rendu par le serveur est l'état FINAL du premier scénario : lisible sans JS, aucun flash ;
// - les scènes sont empilées dans une même cellule de grille et présentes en permanence : la hauteur
//   du bloc est constante, donc CLS 0 même au changement de scénario ;
// - sous prefers-reduced-motion, rien ne bouge (l'exception du terminal ne s'étend pas) ;
// - bloc animé en aria-hidden, transcription complète en sr-only ;
// - bouton pause toujours rendu hors mouvement réduit (WCAG 2.2.2).
import { scenarios } from "../../../config/demo-hero";

const premier = scenarios[0];

const icones = {
  voix: '<rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" />',
  email: '<rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />',
  declencheur: '<circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />',
};

const resume = (s: (typeof scenarios)[number]) =>
  `${s.metier}, ${s.contexte} : « ${s.entree.texte} » Règles lues dans vos outils : ${s.regles
    .map((r) => `${r.regle} (${r.source})`)
    .join(", ")}. ${s.sortie.titre}. ${s.porte ? `${s.porte} ` : ""}${s.action}.`;
---

<figure class="flex flex-col items-center gap-4">
  <div class="section-invert flex w-full max-w-sm flex-col gap-3 rounded-lg border border-border-strong p-3">
    <div class="flex items-center justify-between gap-2">
      <p aria-hidden="true" class="grid font-mono text-12 text-ink-muted">
        {
          scenarios.map((scenario, i) => (
            <span
              data-libelle
              class:list={[
                "col-start-1 row-start-1 flex items-center gap-2 whitespace-nowrap transition-opacity duration-(--duration-base) ease-out",
                i === 0 ? "opacity-100" : "opacity-0",
              ]}
            >
              <svg viewBox="0 0 24 24" class="hidden size-4 shrink-0 sm:block" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <rect x="7" y="2" width="10" height="20" rx="2" /><path d="M11 18h2" />
              </svg>
              {scenario.contexte}
              <span class="text-accent">·</span>
              {scenario.metier}
            </span>
          ))
        }
      </p>
      {/* Sous sm, l'icône du libellé est masquée : sinon libellé + trois boutons débordent à 360 px. */}
      <div class="flex shrink-0 items-center">
        <button
          type="button"
          data-precedent
          aria-label="Cas d'usage précédent"
          title="Cas d'usage précédent"
          class="inline-flex size-6 items-center justify-center rounded-sm text-ink-muted transition-colors duration-(--duration-fast) ease-out hover:text-ink"
        >
          <svg aria-hidden="true" viewBox="0 0 16 16" class="size-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 3 5 8l5 5" />
          </svg>
        </button>
        <button
          type="button"
          data-pause
          aria-pressed="false"
          aria-label="Mettre l'animation en pause"
          title="Mettre l'animation en pause"
          class="inline-flex size-6 items-center justify-center rounded-sm text-ink-muted transition-colors duration-(--duration-fast) ease-out hover:text-ink motion-reduce:hidden"
        >
          <svg aria-hidden="true" viewBox="0 0 16 16" class="size-3" fill="currentColor">
            <path data-icone-pause d="M4 2.5h2.5v11H4zM9.5 2.5H12v11H9.5z" />
            <path data-icone-lecture class="hidden" d="M4 2.5v11l9-5.5-9-5.5Z" />
          </svg>
        </button>
        <button
          type="button"
          data-suivant
          aria-label="Cas d'usage suivant"
          title="Cas d'usage suivant"
          class="inline-flex size-6 items-center justify-center rounded-sm text-ink-muted transition-colors duration-(--duration-fast) ease-out hover:text-ink"
        >
          <svg aria-hidden="true" viewBox="0 0 16 16" class="size-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m6 3 5 5-5 5" />
          </svg>
        </button>
      </div>
    </div>

    <div aria-hidden="true" class="grid" data-scenes>
      {
        scenarios.map((scenario, i) => (
          <div
            data-scene={i}
            data-metier={scenario.metier}
            data-contexte={scenario.contexte}
            data-entree={scenario.entree.type}
            class:list={[
              "col-start-1 row-start-1 flex flex-col gap-3 self-start transition-opacity duration-(--duration-base) ease-out",
              i === 0 ? "opacity-100" : "opacity-0",
            ]}
          >
            {/* L'entrée : une phrase dictée, un email reçu, ou un déclencheur automatique. */}
            <div class="ml-4 flex flex-col gap-2 rounded-md rounded-br-sm border border-accent bg-accent-soft p-3">
              <p class="flex items-center gap-2 font-mono text-12 text-ink">
                <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={icones[scenario.entree.type]} />
                {scenario.entree.libelle}
              </p>
              {/* Le texte complet reste là, invisible : la bulle ne change jamais de hauteur. */}
              <p class="text-14 text-ink">
                <span data-entree-vue>
                  {scenario.entree.cite ? `« ${scenario.entree.texte} »` : scenario.entree.texte}
                </span><span data-entree-reste class="invisible" />
              </p>
            </div>

            {/* Le connecteur : assemblé sur des règles lues dans les outils déjà en place. */}
            <div data-zone="connecteur" class="flex flex-col gap-2 rounded-md border border-accent bg-surface p-3 transition-opacity duration-(--duration-base) ease-out">
              {/* Sous sm, les deux libellés se cassent en deux lignes chacun : on les empile proprement. */}
              <p class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-2">
                <span class="eyebrow">connecteur sosese</span>
                <span class="font-mono text-12 text-ink-muted">lu dans vos outils</span>
              </p>
              <ul class="flex flex-col gap-1">
                {scenario.regles.map((r) => (
                  <li data-regle class="flex items-baseline justify-between gap-3 font-mono text-12 transition-opacity duration-(--duration-base) ease-out">
                    {/* min-w-0 : sans lui, le nom de la règle refuse de passer à la ligne et déborde à 360 px (piège 12). */}
                    <span class="flex min-w-0 items-baseline gap-2 text-ink">
                      <span aria-hidden="true" class="size-1.5 shrink-0 translate-y-[-0.15em] rounded-full bg-accent-bright" />
                      {r.regle}
                    </span>
                    <span class="shrink-0 rounded-full border border-border bg-bg px-2 text-ink-muted">{r.source}</span>
                  </li>
                ))}
              </ul>
            </div>

            {/* La sortie : elle prend la forme du besoin. */}
            <div data-zone="sortie" class="mr-4 flex flex-col gap-2 rounded-md rounded-bl-sm border border-border bg-surface p-3 transition-opacity duration-(--duration-base) ease-out">
              <p class="eyebrow">{scenario.sortie.titre}</p>

              {scenario.sortie.forme === "lignes" && (
                <ul class="flex flex-col gap-1 font-mono text-12">
                  {scenario.sortie.items.map((item) => (
                    <li data-item class="flex items-baseline justify-between gap-2 transition-opacity duration-(--duration-base) ease-out">
                      <span class="text-ink-muted">{item.label}</span>
                      <span class="shrink-0 text-ink">{item.valeur}</span>
                    </li>
                  ))}
                  {scenario.sortie.total && (
                    <li data-item class="flex items-baseline justify-between gap-2 border-t border-border pt-2 font-mono text-14 transition-opacity duration-(--duration-base) ease-out">
                      <span class="text-ink">{scenario.sortie.total.label}</span>
                      <span class="shrink-0 text-accent">{scenario.sortie.total.valeur}</span>
                    </li>
                  )}
                </ul>
              )}

              {scenario.sortie.forme === "message" && (
                <div class="flex flex-col gap-2">
                  <p data-item class="font-mono text-12 text-ink transition-opacity duration-(--duration-base) ease-out">
                    Objet : {scenario.sortie.objet}
                  </p>
                  {scenario.sortie.corps.map((ligne) => (
                    <p data-item class="text-14 text-ink-muted transition-opacity duration-(--duration-base) ease-out">
                      {ligne}
                    </p>
                  ))}
                </div>
              )}

              {scenario.sortie.forme === "agenda" && (
                <div class="flex flex-col gap-2">
                  <p data-item class="font-mono text-12 text-ink transition-opacity duration-(--duration-base) ease-out">
                    {scenario.sortie.jour}
                  </p>
                  <div data-item class="flex flex-col gap-1 transition-opacity duration-(--duration-base) ease-out">
                    <div class="relative h-8 overflow-hidden rounded-sm border border-border bg-bg">
                      <span
                        class="absolute inset-y-1 rounded-sm bg-accent"
                        style={`left: ${(((scenario.sortie.creneau.de - scenario.sortie.debut) / (scenario.sortie.fin - scenario.sortie.debut)) * 100).toFixed(2)}%; width: ${(((scenario.sortie.creneau.a - scenario.sortie.creneau.de) / (scenario.sortie.fin - scenario.sortie.debut)) * 100).toFixed(2)}%`}
                      />
                    </div>
                    <p class="flex justify-between font-mono text-12 text-ink-muted">
                      <span>{scenario.sortie.debut} h</span>
                      <span>{scenario.sortie.fin} h</span>
                    </p>
                  </div>
                  <p data-item class="font-mono text-12 text-ink transition-opacity duration-(--duration-base) ease-out">
                    {scenario.sortie.creneau.de} h – {scenario.sortie.creneau.a} h · {scenario.sortie.label}
                  </p>
                </div>
              )}

              {scenario.sortie.forme === "barres" && (
                <ul class="flex flex-col gap-2">
                  {scenario.sortie.items.map((item) => (
                    <li data-item class="flex flex-col gap-1 transition-opacity duration-(--duration-base) ease-out">
                      <p class="flex items-baseline justify-between gap-2 font-mono text-12">
                        <span class="text-ink-muted">{item.label}</span>
                        <span class="shrink-0 text-ink">{item.valeur}</span>
                      </p>
                      <span class="block h-1.5 rounded-full bg-accent" style={`width: ${item.part}%`} />
                    </li>
                  ))}
                </ul>
              )}
            </div>

            {/* La porte, puis l'action réellement faite. Pas de porte quand il n'y a rien à écrire. */}
            {scenario.porte && (
              <div data-porte class="flex flex-wrap items-center gap-2 transition-opacity duration-(--duration-base) ease-out">
                <span class="text-14 text-ink-muted">{scenario.porte}</span>
                <span class="rounded-full bg-accent px-3 py-1 font-mono text-12 text-on-accent">oui</span>
                <span class="rounded-full border border-border-strong px-3 py-1 font-mono text-12 text-ink-muted">corriger</span>
              </div>
            )}

            {/* L'action faite : pastille pleine + halo discret à son apparition (.action-eclat, global.css). */}
            <p data-action class="flex items-center gap-2 self-start rounded-md border border-accent bg-accent-soft px-2 py-1 font-mono text-12 text-ink transition-opacity duration-(--duration-base) ease-out">
              <span aria-hidden="true" class="flex size-4 shrink-0 items-center justify-center rounded-full bg-accent text-on-accent">✓</span>
              <span>{scenario.action}</span>
            </p>
          </div>
        ))
      }
    </div>
  </div>

  <p class="sr-only">
    Démonstration : cinq tâches très différentes traitées par le même connecteur, qui lit à chaque fois
    des règles déjà présentes dans les logiciels de l'entreprise et termine par une action, faite
    seulement après accord — sauf en lecture seule. {scenarios.map((s) => resume(s)).join(" ")} Scénarios
    types, aucun n'est un document réel.
  </p>
</figure>

<script>
  (function () {
    var scenes = Array.prototype.slice.call(document.querySelectorAll("[data-scene]"));
    if (scenes.length < 2) return;

    var auto = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var conteneur = document.querySelector("[data-scenes]");
    var libelles = Array.prototype.slice.call(document.querySelectorAll("[data-libelle]"));
    var bouton = document.querySelector("[data-pause]");
    var iconePause = document.querySelector("[data-icone-pause]");
    var iconeLecture = document.querySelector("[data-icone-lecture]");

    var MOT = 115; // un mot de transcription
    var ENTREE = 700; // une entrée qui n'est pas dictée (email, déclencheur) : elle apparaît d'un bloc
    var REGLE = 460; // une règle lue dans un outil du client — la partie que le visiteur doit lire
    var ITEM = 360; // un élément de la sortie
    var TENUE = 3400; // temps de lecture de l'état final
    var PREMIERE_TENUE = 1800; // au premier passage : l'état final rendu par le serveur ne s'éternise pas
    var BASCULE = 420; // fondu entre deux scénarios

    var index = 0;
    var enPause = false;
    var visible = true;

    // Lecteur : une liste d'événements datés, joués un par un. Mettre en pause mémorise le temps déjà
    // attendu ; reprendre n'attend que le reste. C'est ce qui fait une vraie pause, sans rien rejouer.
    var evenements = [];
    var prochain = 0;
    var horloge = 0; // date (dans la liste) du dernier événement joué
    var attendu = 0; // temps déjà attendu vers le prochain, avant la dernière pause
    var debut = 0;
    var minuteur = null;

    function arrete() {
      return !auto || enPause || !visible;
    }

    function avancer() {
      if (minuteur || arrete() || prochain >= evenements.length) return;
      var ev = evenements[prochain];
      debut = Date.now();
      minuteur = window.setTimeout(function () {
        minuteur = null;
        horloge = ev.t;
        attendu = 0;
        prochain++;
        ev.fn();
        avancer();
      }, Math.max(0, ev.t - horloge - attendu));
    }

    function suspendre() {
      if (!minuteur) return;
      window.clearTimeout(minuteur);
      minuteur = null;
      attendu += Date.now() - debut;
    }

    function charger(liste) {
      suspendre();
      evenements = liste;
      prochain = 0;
      horloge = 0;
      attendu = 0;
      avancer();
    }

    function zones(scene) {
      return {
        vue: scene.querySelector("[data-entree-vue]"),
        reste: scene.querySelector("[data-entree-reste]"),
        connecteur: scene.querySelector('[data-zone="connecteur"]'),
        regles: Array.prototype.slice.call(scene.querySelectorAll("[data-regle]")),
        sortie: scene.querySelector('[data-zone="sortie"]'),
        items: Array.prototype.slice.call(scene.querySelectorAll("[data-item]")),
        porte: scene.querySelector("[data-porte]"),
        action: scene.querySelector("[data-action]"),
      };
    }

    function montrer(el) {
      if (!el) return;
      el.classList.remove("opacity-0");
      el.classList.add("opacity-100");
    }

    function cacher(el) {
      if (!el) return;
      el.classList.add("opacity-0");
      el.classList.remove("opacity-100");
    }

    function eclat(action) {
      // Relance l'animation CSS : retirer la classe, forcer un recalcul, la remettre.
      action.classList.remove("action-eclat");
      void action.offsetWidth;
      action.classList.add("action-eclat");
    }

    // Texte complet mémorisé une fois : c'est lui qui réserve la hauteur pendant la transcription.
    scenes.forEach(function (scene) {
      scene.dataset.texte = zones(scene).vue.textContent.trim();
    });

    function masquer(scene) {
      var z = zones(scene);
      z.vue.textContent = "";
      z.reste.textContent = scene.dataset.texte;
      z.action.classList.remove("action-eclat");
      [z.connecteur, z.sortie, z.porte, z.action].concat(z.regles).concat(z.items).forEach(cacher);
    }

    function complet(scene) {
      var z = zones(scene);
      z.vue.textContent = scene.dataset.texte;
      z.reste.textContent = "";
      [z.connecteur, z.sortie, z.porte, z.action].concat(z.regles).concat(z.items).forEach(montrer);
    }

    function afficher(n) {
      scenes.forEach(function (scene, i) {
        if (i === n) montrer(scene);
        else cacher(scene);
      });
      libelles.forEach(function (libelle, i) {
        if (i === n) montrer(libelle);
        else cacher(libelle);
      });
    }

    // Les événements d'une scène, à partir de la date t.
    function jouer(scene, t, liste) {
      var z = zones(scene);
      var at = function (fn) {
        liste.push({ t: t, fn: fn });
      };

      if (scene.dataset.entree === "voix") {
        // Une dictée se transcrit au fil de la phrase.
        var mots = scene.dataset.texte.split(" ");
        mots.forEach(function (mot, i) {
          t += MOT;
          at(function () {
            z.vue.textContent = mots.slice(0, i + 1).join(" ");
            z.reste.textContent = (i + 1 < mots.length ? " " : "") + mots.slice(i + 1).join(" ");
          });
        });
      } else {
        // Un email ou un déclencheur arrive d'un bloc : le transcrire mot à mot serait un contresens.
        t += ENTREE;
        at(function () {
          z.vue.textContent = scene.dataset.texte;
          z.reste.textContent = "";
        });
      }

      t += 300;
      at(function () {
        montrer(z.connecteur);
      });
      z.regles.forEach(function (regle) {
        t += REGLE;
        at(function () {
          montrer(regle);
        });
      });

      t += 260;
      at(function () {
        montrer(z.sortie);
      });
      z.items.forEach(function (item) {
        t += ITEM;
        at(function () {
          montrer(item);
        });
      });

      t += 420;
      at(function () {
        montrer(z.porte);
      });

      t += z.porte ? 900 : 300;
      at(function () {
        montrer(z.action);
        eclat(z.action);
      });

      t += TENUE;
      at(function () {
        suivantAuto();
      });
      return liste;
    }

    // Enchaînement automatique : fondu, puis la scène suivante se joue.
    function suivantAuto() {
      var sortante = scenes[index];
      index = (index + 1) % scenes.length;
      var entrante = scenes[index];
      cacher(sortante);
      masquer(entrante);
      var liste = [
        {
          t: BASCULE,
          fn: function () {
            afficher(index);
          },
        },
      ];
      charger(jouer(entrante, BASCULE, liste));
    }

    // Précédent / suivant : on saute directement au cas d'usage. En lecture, il se joue depuis le début ;
    // en pause (ou sous mouvement réduit), il s'affiche complet et se jouera à la reprise.
    function aller(n) {
      suspendre();
      index = (n + scenes.length) % scenes.length;
      var scene = scenes[index];
      afficher(index);
      if (arrete()) {
        complet(scene);
        if (auto) {
          evenements = jouer(scene, 200, [{ t: 0, fn: function () { masquer(scene); } }]);
          prochain = 0;
          horloge = 0;
          attendu = 0;
        }
      } else {
        masquer(scene);
        charger(jouer(scene, 200, []));
      }
    }

    document.querySelector("[data-precedent]").addEventListener("click", function () {
      aller(index - 1);
    });
    document.querySelector("[data-suivant]").addEventListener("click", function () {
      aller(index + 1);
    });

    if (!auto) return;

    bouton.addEventListener("click", function () {
      enPause = !enPause;
      bouton.setAttribute("aria-pressed", String(enPause));
      var libelle = enPause ? "Relancer l'animation" : "Mettre l'animation en pause";
      bouton.setAttribute("aria-label", libelle);
      bouton.setAttribute("title", libelle);
      iconePause.classList.toggle("hidden", enPause);
      iconeLecture.classList.toggle("hidden", !enPause);
      if (enPause) suspendre();
      else avancer();
    });

    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (entrees) {
        visible = entrees[0].isIntersecting;
        if (visible) avancer();
        else suspendre();
      }).observe(conteneur);
    }

    // Premier passage : l'état final rendu par le serveur reste le temps d'être vu, puis la boucle démarre.
    var premier = [
      {
        t: PREMIERE_TENUE,
        fn: function () {
          masquer(scenes[0]);
        },
      },
    ];
    charger(jouer(scenes[0], PREMIERE_TENUE + 200, premier));
  })();
</script>
