---
import {besoins} from "../../config/editorial";
---
<div class="grid gap-6 md:grid-cols-3">
 {besoins.map(b => <article class="rounded-lg border border-border bg-surface p-6">
   <p class="mb-8 font-mono text-14 text-ink-muted">{b.n}</p>
   <h3 class="text-21 font-semibold">{b.titre}</h3>
   <p class="mt-4 text-16 text-ink-muted">{b.texte}</p>
   <p class="mt-6 border-t border-border pt-4 text-14 text-ink">{b.exemple}</p>
 </article>)}
</div>
