---
import Base from "../layouts/Base.astro";
import Button from "../components/ui/Button.astro";
import { cta } from "../config/site";
---

<Base title="Page introuvable | sosese" description="Cette page n'existe pas ou a été déplacée." noindex>
  <section aria-labelledby="erreur-titre" class="py-(--section-y)">
    <div class="container-site flex flex-col items-start gap-6">
      <p class="eyebrow">Erreur 404 · Page introuvable</p>
      <h1 id="erreur-titre" class="max-w-(--measure) text-36 font-semibold tracking-tight md:text-48">
        Cette page n'existe pas.
      </h1>
      <p class="max-w-(--measure) text-18 text-ink-muted">
        Le lien est peut-être ancien, ou l'adresse contient une faute de frappe.
      </p>
      <div class="flex flex-wrap gap-3 pt-2">
        <Button href="/v2/" size="lg">Retour à l'accueil</Button>
        <Button href={cta.href} variant="secondary" size="lg">{cta.label}</Button>
      </div>
    </div>
  </section>
</Base>
