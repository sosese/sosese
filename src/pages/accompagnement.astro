---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Section from "../components/blocs/Section.astro";
import Etapes from "../components/blocs/Etapes.astro";
import QuiDecide from "../components/blocs/QuiDecide.astro";
import ValidationGate from "../components/blocs/ValidationGate.astro";
import Faq from "../components/blocs/Faq.astro";
import NextStep from "../components/blocs/NextStep.astro";
import { cta } from "../config/site";
import { faqAccompagnement, faqJsonLd } from "../config/faq";

// Ce que la proposition écrite précise pour chaque projet (engagements V1 et V2, rien de nouveau).
const donnees = [
  ["Quelles données sont lues", "Pour chaque tâche, la liste des informations consultées. Le reste de vos dossiers n’est pas ouvert."],
  ["Où, et par quel service", "Le service d’IA et l’hébergement utilisés, nommés, avec leur localisation."],
  ["Ce qui est écrit, et après quel « oui »", "Chaque action qui modifie votre logiciel, et le moment où vous la validez."],
  ["À qui sont les accès", "Comptes, clés et code à votre nom, avec le mode d’emploi pour reprendre la main."],
  ["Ce qui se passe en cas d’imprévu", "Si une information manque ou si votre logiciel ne répond pas : le comportement prévu est décrit avant la mise en service."],
];
---
<Base title="Accompagnement, étapes et budget | sosese, Metz" description="Premier échange, atelier sur le terrain, feuille de route chiffrée, puis construction en 4 semaines. Votre temps, les durées et le prix de chaque étape." jsonld={[faqJsonLd(faqAccompagnement)]}>
  <PageHeader action={{ href: cta.href, label: cta.label }} eyebrow="Accompagnement · indépendants, TPE et PME" title="Quatre étapes. Vous décidez à la fin de chacune.">
    Je pars de vos outils et de la personne qui fait la tâche. On choisit ensemble ce qui mérite d’être automatisé, et on s’arrête là si rien ne le mérite.
  </PageHeader>

  <Section id="etapes" title="Ce que chaque étape vous demande, et ce qu’elle vous donne.">
    <Etapes />
  </Section>

  <Section id="controle" tone="subtle" eyebrow="Garder la main" title="Préparer une action n’est pas l’exécuter.">
    <div class="grid items-center gap-8 lg:grid-cols-[3fr_2fr]">
      <QuiDecide />
      <ValidationGate />
    </div>
  </Section>

  <Section id="donnees" eyebrow="Pour vous, ou pour votre prestataire informatique" title="Vos données : ce qui est écrit noir sur blanc avant de commencer." intro="La feuille de route répond par écrit à ces cinq questions, pour chaque automatisation.">
    <dl class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {donnees.map(([q, r]) => <div class="rounded-lg border border-border bg-surface p-6"><dt class="text-18 font-semibold">{q}</dt><dd class="mt-3 text-16 text-ink-muted">{r}</dd></div>)}
    </dl>
    <p class="mt-8 text-16">Pour préparer l’échange : le nom de vos outils, un exemple de tâche répétée et sa fréquence suffisent. N’envoyez pas de données clients confidentielles.</p>
  </Section>

  <Section id="questions" tone="subtle" title="Avant de vous engager.">
    <Faq questions={faqAccompagnement} />
  </Section>

  <NextStep />
</Base>
