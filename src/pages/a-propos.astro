---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Card from "../components/ui/Card.astro";
import Button from "../components/ui/Button.astro";
import ACompleter from "../components/ui/ACompleter.astro";
import CtaFinal from "../components/sections/CtaFinal.astro";
import { personne } from "../config/site";

const principes = [
  {
    titre: "Le résultat avant la technologie",
    texte: "Je pars du temps que vous perdez, pas d'un logiciel à placer. Si un tableur bien construit suffit, je vous le dis.",
  },
  {
    titre: "Des chiffres avant de construire",
    texte: "Chaque piste est chiffrée — temps gagné, coût, faisabilité — pour que vous décidiez en connaissance de cause.",
  },
  {
    titre: "Vous restez propriétaire",
    texte: "Code, accès et documentation vous sont remis. Vous pouvez continuer avec moi, ou sans moi.",
  },
  {
    titre: "Des mots simples",
    texte: "Je parle de devis, de factures et de relances. Le vocabulaire technique reste chez moi.",
  },
];
---

<Base
  title="À propos | sosese"
  description="sosese, c'est Joris Chamvoux : j'accompagne artisans, indépendants et petites entreprises, du repérage des tâches qui prennent du temps jusqu'à l'assistant en service."
>
  <PageHeader eyebrow="À propos" title="Du concret pour les artisans, les indépendants et les petites entreprises">
    sosese, c'est moi, Joris Chamvoux. J'accompagne les artisans, les indépendants et les petites entreprises, du
    repérage des tâches qui prennent du temps jusqu'à l'assistant en service.
  </PageHeader>

  <section aria-labelledby="studio-titre" class="py-(--section-y)">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <SectionHeading id="studio-titre" eyebrow="Ma démarche" title="Repérer, choisir, construire" />
      <div class="flex flex-col gap-4 text-18 text-ink-muted">
        <p>
          Les nouvelles technologies sont souvent vendues comme des réponses à la recherche d'une question. Je fais
          l'inverse : je pars des tâches répétitives qui pèsent sur vos journées, je mesure ce qu'elles coûtent, puis
          je choisis avec vous celles qu'un assistant peut prendre en charge.
        </p>
        <p>
          Ce qui est construit se branche sur vos logiciels actuels et vous appartient entièrement.
        </p>
        <div class="pt-2">
          <Button href="/#methode" variant="secondary">Voir la méthode</Button>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="posture-titre" class="border-y border-border bg-bg-subtle py-(--section-y)">
    <div class="container-site flex flex-col gap-12">
      <SectionHeading id="posture-titre" eyebrow="La posture" title="Quatre principes qui guident chaque mission" />
      <ul class="grid gap-4 md:grid-cols-2">
        {
          principes.map((p, i) => (
            <li class="flex">
              <Card interactive class="flex w-full flex-col gap-3">
                <span class="text-12 text-accent tabular-nums">0{i + 1}</span>
                <h3 class="text-21 font-semibold">{p.titre}</h3>
                <p class="text-16 text-ink-muted">{p.texte}</p>
              </Card>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    personne ? (
      <section aria-labelledby="personne-titre" class="py-(--section-y)">
        <div class="container-site grid items-start gap-12 md:grid-cols-[1fr_2fr]">
          <img src={personne.photo} alt={`Portrait de ${personne.nom}`} width="480" height="600" class="aspect-4/5 w-full rounded-lg border border-border object-cover" />
          <div class="flex flex-col gap-4">
            <p class="eyebrow">La personne</p>
            <h2 id="personne-titre" class="text-28 md:text-36">{personne.nom}</h2>
            <p class="text-14 text-ink-muted">{personne.role}</p>
            <div class="flex max-w-(--measure) flex-col gap-4 text-18 text-ink-muted">
              {personne.bio.map((paragraphe) => <p>{paragraphe}</p>)}
            </div>
          </div>
        </div>
      </section>
    ) : (
      import.meta.env.DEV && (
        <section aria-labelledby="personne-titre" class="py-(--section-y)">
          <div class="container-site flex flex-col gap-4">
            <p class="eyebrow">La personne</p>
            <h2 id="personne-titre" class="text-28">Section masquée en production</h2>
            <p class="text-16 text-ink-muted">
              <ACompleter label="photo, nom, rôle et bio (§9) dans src/config/site.ts → personne" />
            </p>
          </div>
        </section>
      )
    )
  }

  <CtaFinal />
</Base>
