---
import Base from "../layouts/Base.astro";
import Button from "../components/ui/Button.astro";
import VracEnActions from "../components/ui/diagrams/VracEnActions.astro";
import Section from "../components/blocs/Section.astro";
import Proof from "../components/blocs/Proof.astro";
import Needs from "../components/blocs/Needs.astro";
import Etapes from "../components/blocs/Etapes.astro";
import Interlocuteur from "../components/blocs/Interlocuteur.astro";
import Faq from "../components/blocs/Faq.astro";
import NextStep from "../components/blocs/NextStep.astro";
import { cta, ctaRassurance, delaiReponse, lien, secondaryNav } from "../config/site";
import { scenes } from "../config/editorial";
import { faqAccueil, faqJsonLd } from "../config/faq";
---
<Base jsonld={[faqJsonLd(faqAccueil)]}>
  <section class="py-(--hero-y)">
    <div class="container-site grid items-center gap-10 lg:grid-cols-[6fr_5fr] lg:gap-12">
      <div>
        <p class="eyebrow mb-5">Entreprises de terrain · Metz et 80 km autour</p>
        <h1 class="text-36 font-semibold md:text-48">Dictez le devis sur le chantier. Retrouvez-le prêt dans votre logiciel.</h1>
        <p class="mt-6 max-w-(--measure) text-18 text-ink-muted">
          Je relie vos notes, vos messages et vos demandes au logiciel de gestion que vous utilisez déjà, pour préparer devis, fiches clients et rendez-vous. <strong class="font-medium text-ink">Vous validez : rien ne part sans vous.</strong>
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <Button href={cta.href} size="lg">{cta.label} <span aria-hidden="true">→</span></Button>
          <a class="lien-texte text-16" href="#cas-client">Voir le cas d’un poseur de sols</a>
        </div>
        <p class="mt-5 text-14 text-ink-muted">{ctaRassurance}{delaiReponse && ` Réponse ${delaiReponse}.`}</p>
      </div>
      <div class="min-w-0"><VracEnActions /><p class="mt-3 text-center text-12 text-ink-muted">Illustration · données fictives</p></div>
    </div>
  </section>

  <Proof />

  <Section id="constat" eyebrow="Le constat" title="Le temps que personne n’a décidé de perdre.">
    <ul class="grid gap-8 md:grid-cols-3">
      {scenes.map((s) => <li class="border-l-2 border-border-strong pl-5"><h3 class="text-18 font-semibold">{s.titre}</h3><p class="mt-2 text-16 text-ink-muted">{s.texte}</p></li>)}
    </ul>
  </Section>

  <Section id="offre" tone="subtle" eyebrow="Par où commencer" title="Trois tâches qui reviennent chaque semaine.">
    <Needs />
  </Section>

  <Section id="methode" eyebrow="Comment on travaille" title="Vérifier l’utilité avant de construire." intro="Rien ne se construit avant que vous ayez vu ce que ça coûte et ce que ça rapporte. Vous décidez à la fin de chaque étape.">
    <Etapes compact />
    <a href={lien("/accompagnement")} class="lien-texte mt-8 inline-block">Le détail de chaque étape et le budget →</a>
  </Section>

  <section id="interlocuteur" aria-labelledby="interlocuteur-titre" class="border-t border-border bg-bg-subtle py-(--section-y)">
    <div class="container-site">
      <Interlocuteur>
        <div class="flex flex-wrap gap-6">
          <a href={lien("/a-propos")} class="lien-texte">Faire connaissance →</a>
          {secondaryNav.map((l) => <a href={l.href} class="lien-texte">{l.label} →</a>)}
        </div>
      </Interlocuteur>
    </div>
  </section>

  <Section id="questions" title="Les questions qu’on me pose avant de commencer.">
    <Faq questions={faqAccueil} />
  </Section>

  <NextStep />
</Base>
