---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/ui/PageHeader.astro";
import Card from "../components/ui/Card.astro";
import Questionnaire from "../components/islands/Questionnaire";
import { site } from "../config/site";
import { TITRE } from "../lib/questionnaire";

// Page envoyée par lien direct aux prospects : hors navigation, non indexée.
---

<Base
  title={`${TITRE} | sosese`}
  description="Un questionnaire de six minutes sur les tâches qui prennent du temps aux dirigeants de petites entreprises."
  noindex
>
  <PageHeader eyebrow="Questionnaire" title={TITRE}>
    J'accompagne les dirigeants de petites entreprises qui manquent d'heures dans la journée. Avant de proposer quoi
    que ce soit, je cherche à comprendre votre quotidien : vos tâches, vos outils, ce qui vous freine. Il n'y a ni
    bonne ni mauvaise réponse, et ce questionnaire ne vous engage à rien.
  </PageHeader>

  <div class="container-site py-(--section-y)">
    <div class="mx-auto flex max-w-(--measure) flex-col gap-6">
      <Card padding="lg">
        <Questionnaire client:idle fallbackEmail={site.email} />
      </Card>
      <p class="text-14 text-ink-muted">
        Vos réponses ne sont lues que par moi, Joris Chamvoux, jamais revendues ni publiées.
        <a href="/confidentialite" class="text-accent underline underline-offset-4 hover:text-accent-hover">En savoir plus</a>.
      </p>
    </div>
  </div>
</Base>
