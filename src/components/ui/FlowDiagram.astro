---
type Props = {
  steps: string[];
  label: string;
};

const { steps, label } = Astro.props;
const delayStep = 600;
---

<ol class="flex flex-col lg:flex-row lg:items-center" aria-label={label}>
  {
    steps.map((step, i) => (
      <>
        <li class="flex h-12 items-center gap-3 rounded-md border border-border bg-bg-subtle px-4 font-mono text-12 whitespace-nowrap text-ink lg:flex-1 lg:justify-center lg:px-3">
          <span class="text-accent">{String(i + 1).padStart(2, "0")}</span>
          {step}
        </li>
        {i < steps.length - 1 && (
          <li aria-hidden="true" class="relative ml-6 h-6 w-px shrink-0 bg-border-strong lg:ml-0 lg:h-px lg:w-6">
            <span
              class="flow-pulse absolute size-1.5 -translate-1/2 rounded-full bg-accent-bright opacity-0 motion-reduce:hidden max-lg:left-1/2 lg:top-1/2"
              style={`--flow-delay: ${i * delayStep}ms`}
            />
          </li>
        )}
      </>
    ))
  }
</ol>
