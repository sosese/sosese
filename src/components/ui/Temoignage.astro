---
// Témoignage d'un client réel (DESIGN.md, « Clients » et « Le cas ») : sa phrase en grand, sa signature,
// son logo. Statique, aucun script : une parole de client ne s'anime pas.
//
// Règles dures :
// - la citation est celle du client, retouchée pour l'orthographe seulement et avec son accord ;
// - rien ne s'affiche qui ne vienne de lui (prénom, nom, rôle, entreprise, logo) ;
// - `nomFamille` à `null` : marqueur « à compléter » en dev, rien en production — jamais un nom inventé.
import { existsSync, readFileSync } from "node:fs";
import { join } from "node:path";
import ACompleter from "./ACompleter.astro";

type Props = {
  citation: string;
  prenom: string;
  nomFamille: string | null;
  role: string;
  entreprise: string;
  // Site du client : le nom de l'entreprise devient le seul lien du bloc.
  site?: string | null;
  // Chemin d'un fichier de `public/`. Absent du disque : pas d'image, jamais de vignette cassée.
  logo?: string | null;
  class?: string;
};

const { citation, prenom, nomFamille, role, entreprise, site, logo: cheminLogo, class: className } = Astro.props;

// Le logo est un fichier fourni par le client, servi tel quel — exception assumée à la règle
// « schémas SVG, pas d'images » : l'identité d'un tiers ne se redessine pas (DESIGN.md, « Le cas »).
// `process.cwd()` et non `import.meta.url` : au build, ce module est un chunk, son URL ne pointe
// plus sur les sources (piège 24). Astro se lance toujours depuis la racine du projet.
const fichierLogo = cheminLogo ? join(process.cwd(), "public", cheminLogo) : null;
const logo = fichierLogo && existsSync(fichierLogo) ? cheminLogo : null;

// Hauteur de rendu fixée ; la largeur est déduite du `viewBox` du SVG pour réserver la place (CLS 0).
const HAUTEUR_LOGO = 40;
const viewBox = logo?.endsWith(".svg")
  ? readFileSync(fichierLogo!, "utf8").match(/viewBox="[\d.\s-]*?([\d.]+)\s+([\d.]+)"/)
  : null;
const largeurLogo = viewBox ? Math.round((HAUTEUR_LOGO * Number(viewBox[1])) / Number(viewBox[2])) : undefined;
---

<figure class:list={["flex flex-col gap-6 rounded-lg border border-border bg-surface p-6 md:p-10", className]}>
  {/* Le lettrage du client est blanc sur fond transparent : il disparaîtrait sur le fond clair. Il est
      posé sur une plaque `section-invert`, sombre dans les deux thèmes, plutôt que retouché. Décoratif
      (`alt` vide) : le nom de l'entreprise est écrit dans la signature, qui porte le lien. */}
  {
    logo && (
      <span class="section-invert inline-flex w-fit items-center rounded-md px-4 py-3">
        <img src={logo} alt="" height={HAUTEUR_LOGO} width={largeurLogo} loading="lazy" decoding="async" class="h-10 w-auto" />
      </span>
    )
  }

  <blockquote class="max-w-(--measure) font-display text-21 leading-(--leading-tight) text-ink md:text-28 lg:text-36">
    {/* Guillemets français collés par une espace fine insécable (U+202F), comme ailleurs sur le site. */}
    <p>{`«\u202F${citation}\u202F»`}</p>
  </blockquote>

  <figcaption class="text-16 text-ink-muted">
    <span class="font-semibold text-ink">{prenom}{nomFamille ? ` ${nomFamille}` : import.meta.env.DEV && <Fragment> <ACompleter label="nom de famille" /></Fragment>}</span>, {role} —{" "}
    {
      site ? (
        <a
          href={site}
          rel="noopener"
          class="underline underline-offset-4 transition-colors duration-(--duration-fast) ease-out hover:text-ink"
        >
          {entreprise}<span aria-hidden="true"> ↗</span>
        </a>
      ) : (
        entreprise
      )
    }
  </figcaption>
</figure>
