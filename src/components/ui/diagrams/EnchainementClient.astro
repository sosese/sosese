---
// Démonstration du cas client (registre R2), allégée le 2026-10-08 (plan « site moins geek », étape 3) :
// un devis en trois temps — il dicte, le devis se prépare, il vérifie et c'est enregistré. Jouée en boucle,
// APRÈS le témoignage : elle montre le principe, les chiffres du client restent au-dessus.
//
// Règles dures (DESIGN.md, « Le cas ») :
// - scénario INVENTÉ : client, commune et montants ne viennent d'aucune pièce réelle (piège 17), et la
//   légende visible le dit (« Exemple illustratif ») ;
// - l'écriture arrive après le « oui » ;
// - aucun jargon technique, y compris dans les petits libellés ;
// - les montants restent petits et sans couleur d'accent : ils ne concurrencent pas les chiffres du client.
//
// Contrat, identique à celui du mockup du hero :
// - l'état rendu par le serveur est l'état FINAL (tout visible) : lisible sans JS, aucun flash ;
// - tout le contenu reste dans le DOM, seule l'opacité change : hauteur constante, CLS 0 ;
// - sous prefers-reduced-motion, rien ne bouge ;
// - bouton pause toujours rendu hors mouvement réduit (WCAG 2.2.2), pause aussi hors écran.

const dictee = "«\u202FFais le devis de la famille Martin : parquet chêne collé sur 25 m², plinthes et vitrification.\u202F»";
const lignes = [
  { label: "Parquet chêne, 25 m²", valeur: "2 250,00 €" },
  { label: "Plinthes, 12 ml", valeur: "96,00 €" },
  { label: "Vitrification", valeur: "350,00 €" },
  { label: "Total TTC", valeur: "2 965,60 €", fort: true },
];
const validation = "«\u202FC'est bon, enregistre-le.\u202F»";

// Classes communes aux trois temps.
const carte = "flex flex-col gap-3 rounded-md border border-border bg-bg p-4 transition-colors duration-(--duration-slow) ease-out";
const bulle =
  "rounded-md rounded-br-sm border border-accent bg-accent-soft p-3 text-14 text-ink transition-opacity duration-(--duration-slow) ease-out";
const fondu = "transition-opacity duration-(--duration-slow) ease-out";
---

<figure data-cc class="flex w-full flex-col gap-5 rounded-lg border border-border bg-surface p-6">
  <div class="flex items-start justify-between gap-4">
    <p class="eyebrow">Un devis, en trois temps</p>
    <button
      type="button"
      data-cc-pause
      aria-pressed="false"
      aria-label="Mettre l'animation en pause"
      title="Mettre l'animation en pause"
      class="inline-flex size-8 shrink-0 items-center justify-center rounded-sm text-ink-muted transition-colors duration-(--duration-fast) ease-out hover:text-ink motion-reduce:hidden"
    >
      <svg aria-hidden="true" viewBox="0 0 16 16" class="size-3" fill="currentColor">
        <path data-cc-icone-pause d="M4 2.5h2.5v11H4zM9.5 2.5H12v11H9.5z" />
        <path data-cc-icone-lecture class="hidden" d="M4 2.5v11l9-5.5-9-5.5Z" />
      </svg>
    </button>
  </div>

  <ol class="grid gap-3 lg:grid-cols-3">
    <li data-cc-etape class={carte}>
      <p class="flex items-baseline gap-2 text-16 font-semibold">
        <span class="text-14 font-normal text-accent tabular-nums">1</span> Il dicte
      </p>
      <p data-cc-pas class={bulle}>{dictee}</p>
    </li>

    <li data-cc-etape class={carte}>
      <p class="flex items-baseline gap-2 text-16 font-semibold">
        <span class="text-14 font-normal text-accent tabular-nums">2</span> Le devis se prépare
      </p>
      {/* Le cadre arrive avec sa première ligne : jamais de cadre vide à l'écran. */}
      <ul data-cc-pas class:list={["flex flex-col gap-1 rounded-md border border-border bg-surface p-3 text-12", fondu]}>
        {
          lignes.map((ligne, i) => (
            <li
              data-cc-pas={i > 0 ? "" : undefined}
              class:list={["flex items-baseline justify-between gap-2", fondu, ligne.fort && "border-t border-border pt-2"]}
            >
              <span class={ligne.fort ? "text-ink" : "text-ink-muted"}>{ligne.label}</span>
              <span class:list={["shrink-0 text-right text-ink tabular-nums", ligne.fort && "font-semibold"]}>{ligne.valeur}</span>
            </li>
          ))
        }
      </ul>
    </li>

    <li data-cc-etape class={carte}>
      <p class="flex items-baseline gap-2 text-16 font-semibold">
        <span class="text-14 font-normal text-accent tabular-nums">3</span> Il vérifie, c'est enregistré
      </p>
      <p data-cc-pas class={bulle}>{validation}</p>
      <p data-cc-pas class:list={["flex flex-wrap items-center gap-2 text-12 text-accent", fondu]}>
        <span class="rounded-full bg-accent px-2 text-on-accent">oui</span>
        <span aria-hidden="true">✓</span>
        <span>devis enregistré dans le logiciel</span>
      </p>
    </li>
  </ol>

  <figcaption class="text-12 text-ink-muted">Exemple illustratif : client et montants inventés.</figcaption>
</figure>

<script>
  (function () {
    var racine = document.querySelector("[data-cc]");
    if (!racine || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    var etapes = Array.prototype.slice.call(racine.querySelectorAll("[data-cc-etape]"));
    var bouton = racine.querySelector("[data-cc-pause]");
    var iconePause = racine.querySelector("[data-cc-icone-pause]");
    var iconeLecture = racine.querySelector("[data-cc-icone-lecture]");

    var PAS = 520; // un élément révélé
    var ENTREE = 700; // avant le premier élément d'une étape
    var APRES = 1100; // l'étape terminée reste en avant avant de passer la main
    var TENUE = 3800; // tout est visible, le temps de relire
    var EFFACE = 700; // fondu avant de rejouer

    var minuteurs = [];
    var enPause = false;
    var visible = false;

    function planifier(fn, delai) {
      minuteurs.push(window.setTimeout(fn, delai));
    }

    function stopper() {
      minuteurs.forEach(window.clearTimeout);
      minuteurs = [];
    }

    function pas(etape) {
      return Array.prototype.slice.call(etape.querySelectorAll("[data-cc-pas]"));
    }

    function activer(etape, oui) {
      etape.classList.toggle("border-accent", oui);
      etape.classList.toggle("border-border", !oui);
    }

    function montrer(el, oui) {
      el.classList.toggle("opacity-0", !oui);
    }

    function effacer() {
      etapes.forEach(function (etape) {
        activer(etape, false);
        pas(etape).forEach(function (el) {
          montrer(el, false);
        });
      });
    }

    function cycle() {
      stopper();
      effacer();
      var t = EFFACE;
      etapes.forEach(function (etape) {
        planifier(function () {
          activer(etape, true);
        }, t);
        t += ENTREE;
        pas(etape).forEach(function (el) {
          planifier(function () {
            montrer(el, true);
          }, t);
          t += PAS;
        });
        t += APRES;
        planifier(function () {
          activer(etape, false);
        }, t);
      });
      t += TENUE;
      planifier(cycle, t);
    }

    function demarrer() {
      if (!enPause && visible) cycle();
    }

    bouton.addEventListener("click", function () {
      enPause = !enPause;
      bouton.setAttribute("aria-pressed", String(enPause));
      var libelle = enPause ? "Relancer l'animation" : "Mettre l'animation en pause";
      bouton.setAttribute("aria-label", libelle);
      bouton.setAttribute("title", libelle);
      iconePause.classList.toggle("hidden", enPause);
      iconeLecture.classList.toggle("hidden", !enPause);
      if (enPause) {
        // En pause, on rend l'état complet : rien ne reste à moitié affiché.
        stopper();
        effacer();
        etapes.forEach(function (etape) {
          pas(etape).forEach(function (el) {
            montrer(el, true);
          });
        });
      } else demarrer();
    });

    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        function (entrees) {
          var etait = visible;
          visible = entrees[0].isIntersecting;
          if (!visible) stopper();
          else if (!etait) demarrer();
        },
        { threshold: 0.3 },
      ).observe(racine);
    }
  })();
</script>
