---
// Mockup stylisé (registre R2) du hero : la dictée se fait sur le chantier, depuis un téléphone ;
// le chiffrage repart de votre catalogue ; la réponse revient dans le même fil, au téléphone comme
// au bureau. Statique : aucun JS, aucune image, aucun logo tiers. Scénario inventé, légendé comme tel
// (DESIGN.md, « Cas client » et piège 17). Les lignes et les montants ne viennent d'aucune pièce réelle.
const lignes = [
  { designation: "Parquet chêne posé", detail: "25 m²", total: "2 250,00 €" },
  { designation: "Plinthes posées", detail: "12 ml", total: "96,00 €" },
  { designation: "Ponçage, vitrification", detail: "25 m²", total: "350,00 €" },
];
---

<figure class="flex flex-col items-center gap-4">
  <div class="w-full max-w-sm rounded-lg border border-border-strong bg-surface p-3">
    <!-- Haut-parleur : c'est ce qui fait lire le cadre comme un téléphone. -->
    <div aria-hidden="true" class="flex justify-center pb-2">
      <span class="h-1 w-12 rounded-full bg-border-strong"></span>
    </div>

    <div class="flex flex-col gap-3 rounded-md border border-border bg-bg p-3">
      <p class="flex items-center justify-between gap-2 font-mono text-12 text-ink-muted">
        <span class="flex items-center gap-2">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="7" y="2" width="10" height="20" rx="2" /><path d="M11 18h2" />
          </svg>
          sur le chantier
        </span>
        <span>16 h 40</span>
      </p>

      <!-- Ce que le poseur dit, sans rien taper. -->
      <div class="ml-4 flex flex-col gap-2 rounded-md rounded-br-sm border border-accent bg-accent-soft p-3">
        <p class="flex items-center gap-2 font-mono text-12 text-ink">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" />
          </svg>
          dicté
        </p>
        <p class="text-14 text-ink">
          « 25 m² de parquet chêne collé, 12 mètres de plinthes, ponçage et vitrification. »
        </p>
      </div>

      <p aria-hidden="true" class="flex items-center gap-2 font-mono text-12 text-ink-muted">
        <span class="h-px flex-1 bg-border"></span>
        <span class="whitespace-nowrap">vos prix, vos règles de TVA</span>
        <span class="h-px flex-1 bg-border"></span>
      </p>

      <!-- Ce qui revient dans le même fil, quelques secondes plus tard. -->
      <div class="mr-4 flex flex-col gap-2 rounded-md rounded-bl-sm border border-border bg-surface p-3">
        <ul class="flex flex-col gap-1 font-mono text-12">
          {
            lignes.map((ligne) => (
              <li class="flex items-baseline justify-between gap-2">
                <span class="text-ink-muted">{ligne.designation}</span>
                <span class="whitespace-nowrap text-ink">{ligne.total}</span>
              </li>
            ))
          }
        </ul>
        <p class="flex items-baseline justify-between gap-2 border-t border-border pt-2 font-mono text-14">
          <span class="text-ink">Total TTC</span>
          <span class="text-accent">2 965,60 €</span>
        </p>
      </div>

      <!-- La porte : rien n'est créé tant que la réponse n'est pas donnée. -->
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-14 text-ink-muted">Je crée le devis ?</span>
        <span aria-hidden="true" class="rounded-full bg-accent px-3 py-1 font-mono text-12 text-on-accent">oui</span>
        <span aria-hidden="true" class="rounded-full border border-border-strong px-3 py-1 font-mono text-12 text-ink-muted">corriger</span>
      </div>
    </div>
  </div>

  <figcaption class="flex flex-col items-center gap-2 text-center">
    <p class="flex items-center justify-center gap-2 font-mono text-12 text-ink-muted">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <rect x="7" y="2" width="10" height="20" rx="2" /><path d="M11 18h2" />
      </svg>
      <span aria-hidden="true">+</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="12" rx="2" /><path d="M2 20h20" />
      </svg>
      sur le chantier comme au bureau
    </p>
    <p class="font-mono text-12 text-ink-muted">Scénario type, pas un devis réel.</p>
  </figcaption>
</figure>
