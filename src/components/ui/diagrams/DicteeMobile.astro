---
// Mockup animé du hero (registre R2). Quatre métiers joués à la suite, en boucle : la dictée se
// transcrit mot à mot, le connecteur s'assemble sur les règles du client, puis le devis tombe ligne
// à ligne et attend un accord. Scénarios inventés (voir src/config/demo-hero.ts).
//
// Contrat, identique à celui du terminal et de la démo du cas client :
// - l'état rendu par le serveur est l'état FINAL du premier scénario : lisible sans JS, aucun flash ;
// - les quatre scènes sont empilées dans une même cellule de grille et présentes en permanence :
//   la hauteur du bloc est constante, donc CLS 0 même au changement de métier ;
// - sous prefers-reduced-motion, rien ne bouge (l'exception du terminal ne s'étend pas, DESIGN.md) :
//   le premier scénario reste affiché et la liste des métiers est donnée en toutes lettres ;
// - bloc animé en aria-hidden, transcription complète en sr-only ;
// - bouton pause toujours rendu (WCAG 2.2.2 : l'animation dure plus de 5 s et démarre seule).
import { scenarios } from "../../../config/demo-hero";

const premier = scenarios[0];
const metiers = scenarios.map((s) => s.metier);
---

<figure class="flex flex-col items-center gap-4">
  <div class="w-full max-w-sm rounded-lg border border-border-strong bg-surface p-3">
    <div aria-hidden="true" class="flex justify-center pb-2">
      <span class="h-1 w-12 rounded-full bg-border-strong"></span>
    </div>

    <div class="flex flex-col gap-3 rounded-md border border-border bg-bg p-3">
      <div class="flex items-center justify-between gap-2">
        <p aria-hidden="true" class="flex items-center gap-2 font-mono text-12 text-ink-muted">
          <svg viewBox="0 0 24 24" class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="7" y="2" width="10" height="20" rx="2" /><path d="M11 18h2" />
          </svg>
          sur le chantier
          <span class="text-accent">·</span>
          <span data-metier-actif>{premier.metier}</span>
        </p>
        <button
          type="button"
          data-pause
          aria-pressed="false"
          aria-label="Mettre l'animation en pause"
          title="Mettre l'animation en pause"
          class="inline-flex size-6 shrink-0 items-center justify-center rounded-sm text-ink-muted transition-colors duration-(--duration-fast) ease-out hover:text-ink motion-reduce:hidden"
        >
          <svg aria-hidden="true" viewBox="0 0 16 16" class="size-3" fill="currentColor">
            <path data-icone-pause d="M4 2.5h2.5v11H4zM9.5 2.5H12v11H9.5z" />
            <path data-icone-lecture class="hidden" d="M4 2.5v11l9-5.5-9-5.5Z" />
          </svg>
        </button>
      </div>

      <div aria-hidden="true" class="grid" data-scenes>
        {
          scenarios.map((scenario, i) => (
            <div
              data-scene={i}
              data-metier={scenario.metier}
              class:list={[
                "col-start-1 row-start-1 flex flex-col gap-3 transition-opacity duration-(--duration-base) ease-out",
                i === 0 ? "opacity-100" : "opacity-0",
              ]}
            >
              {/* Ce qui est dit sur le chantier, transcrit au fil de la phrase. */}
              <div class="ml-4 flex flex-col gap-2 rounded-md rounded-br-sm border border-accent bg-accent-soft p-3">
                <p class="flex items-center gap-2 font-mono text-12 text-ink">
                  <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3" />
                  </svg>
                  dicté
                </p>
                {/* Le texte complet reste là, invisible : la bulle ne change jamais de hauteur. */}
                <p class="text-14 text-ink">
                  <span data-dictee-vue>{`\u00ab\u202f${scenario.dictee}\u202f\u00bb`}</span><span data-dictee-reste class="invisible" />
                </p>
              </div>

              {/* Le connecteur : assemblé sur les règles du client, placé entre la voix et le devis. */}
              <div data-zone="connecteur" class="flex flex-col gap-2 rounded-md border border-accent bg-surface p-3 transition-opacity duration-(--duration-base) ease-out">
                <p class="flex items-center justify-between gap-2">
                  <span class="eyebrow">connecteur sosese</span>
                  <span class="font-mono text-12 text-ink-muted">vos règles</span>
                </p>
                <ul class="flex flex-wrap gap-1">
                  {scenario.regles.map((regle) => (
                    <li
                      data-regle
                      class="flex items-center gap-1 rounded-full border border-accent bg-accent-soft px-2 py-1 font-mono text-12 text-ink transition-opacity duration-(--duration-base) ease-out"
                    >
                      <span aria-hidden="true" class="size-1.5 shrink-0 rounded-full bg-accent-bright" />
                      {regle}
                    </li>
                  ))}
                </ul>
              </div>

              {/* Ce qui revient dans le même fil. */}
              <div data-zone="devis" class="mr-4 flex flex-col gap-2 rounded-md rounded-bl-sm border border-border bg-surface p-3 transition-opacity duration-(--duration-base) ease-out">
                <ul class="flex flex-col gap-1 font-mono text-12">
                  {scenario.lignes.map((ligne) => (
                    <li data-ligne class="flex items-baseline justify-between gap-2 transition-opacity duration-(--duration-base) ease-out">
                      <span class="text-ink-muted">{ligne.designation}</span>
                      <span class="shrink-0 text-ink">{ligne.total}</span>
                    </li>
                  ))}
                </ul>
                <p data-total class="flex items-baseline justify-between gap-2 border-t border-border pt-2 font-mono text-14 transition-opacity duration-(--duration-base) ease-out">
                  <span class="text-ink">Total TTC</span>
                  <span class="text-accent">{scenario.totalTtc}</span>
                </p>
              </div>
            </div>
          ))
        }
      </div>

      {/* La porte : identique pour les quatre métiers, donc rendue une seule fois. */}
      <div aria-hidden="true" data-porte class="flex flex-wrap items-center gap-2 transition-opacity duration-(--duration-base) ease-out">
        <span class="text-14 text-ink-muted">Je crée le devis ?</span>
        <span class="rounded-full bg-accent px-3 py-1 font-mono text-12 text-on-accent">oui</span>
        <span class="rounded-full border border-border-strong px-3 py-1 font-mono text-12 text-ink-muted">corriger</span>
      </div>
    </div>
  </div>

  <p class="sr-only">
    Démonstration : une phrase dictée sur le chantier, un connecteur assemblé sur les règles de
    l'entreprise, un devis chiffré qui attend un accord avant d'être créé. Le même principe est joué
    pour quatre métiers : {metiers.join(", ")}. Exemple pour un {premier.metier} : « {premier.dictee} ».
    Le connecteur applique {premier.regles.join(", ")}. Résultat : {premier.lignes.map((l) => `${l.designation}, ${l.quantite}, ${l.total}`).join(" ; ")}.
    Total TTC {premier.totalTtc}, à valider avant création. Scénario type, pas un devis réel.
  </p>

  <figcaption class="flex flex-col items-center gap-2 text-center">
    <p class="flex items-center justify-center gap-2 font-mono text-12 text-ink-muted">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <rect x="7" y="2" width="10" height="20" rx="2" /><path d="M11 18h2" />
      </svg>
      <span aria-hidden="true">+</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="12" rx="2" /><path d="M2 20h20" />
      </svg>
      sur le chantier comme au bureau
    </p>
    {/* Sans animation, la rotation des métiers n'a pas lieu : on les nomme. */}
    <p class="hidden font-mono text-12 text-ink-muted motion-reduce:block">{metiers.join(" · ")}</p>
    <p class="font-mono text-12 text-ink-muted">Scénario type, pas un devis réel.</p>
  </figcaption>
</figure>

<script is:inline>
  (function () {
    var scenes = Array.prototype.slice.call(document.querySelectorAll("[data-scene]"));
    if (scenes.length < 2) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    var conteneur = document.querySelector("[data-scenes]");
    var porte = document.querySelector("[data-porte]");
    var etiquette = document.querySelector("[data-metier-actif]");
    var bouton = document.querySelector("[data-pause]");
    var iconePause = document.querySelector("[data-icone-pause]");
    var iconeLecture = document.querySelector("[data-icone-lecture]");

    var MOT = 115; // un mot de transcription
    var REGLE = 320; // une règle qui s'ajoute au connecteur
    var LIGNE = 360; // une ligne de devis qui tombe
    var TENUE = 3400; // temps de lecture de l'état final
    var PREMIERE_TENUE = 1800; // au premier passage : l'état final rendu par le serveur ne s'éternise pas
    var BASCULE = 420; // fondu entre deux métiers

    var index = 0;
    var premier = true;
    var enPause = false;
    var visible = true;
    var minuteurs = [];

    function planifier(fn, delai) {
      minuteurs.push(window.setTimeout(fn, delai));
    }

    function stopper() {
      minuteurs.forEach(window.clearTimeout);
      minuteurs = [];
    }

    function zones(scene) {
      return {
        vue: scene.querySelector("[data-dictee-vue]"),
        reste: scene.querySelector("[data-dictee-reste]"),
        connecteur: scene.querySelector('[data-zone="connecteur"]'),
        devis: scene.querySelector('[data-zone="devis"]'),
        regles: Array.prototype.slice.call(scene.querySelectorAll("[data-regle]")),
        lignes: Array.prototype.slice.call(scene.querySelectorAll("[data-ligne]")),
        total: scene.querySelector("[data-total]"),
      };
    }

    // Texte complet mémorisé une fois : c'est lui qui réserve la hauteur pendant la transcription.
    scenes.forEach(function (scene) {
      var z = zones(scene);
      scene.dataset.texte = z.vue.textContent;
    });

    function masquer(scene) {
      var z = zones(scene);
      z.vue.textContent = "";
      z.reste.textContent = scene.dataset.texte;
      [z.connecteur, z.devis].forEach(function (el) {
        el.classList.add("opacity-0");
        el.classList.remove("opacity-100");
      });
      z.regles.concat(z.lignes).concat([z.total]).forEach(function (el) {
        el.classList.add("opacity-0");
        el.classList.remove("opacity-100");
      });
    }

    function jouer(scene) {
      var z = zones(scene);
      var mots = scene.dataset.texte.split(" ");
      var t = 0;

      mots.forEach(function (mot, i) {
        t += MOT;
        planifier(function () {
          z.vue.textContent = mots.slice(0, i + 1).join(" ");
          z.reste.textContent = (i + 1 < mots.length ? " " : "") + mots.slice(i + 1).join(" ");
        }, t);
      });

      t += 300;
      planifier(function () {
        z.connecteur.classList.remove("opacity-0");
        z.connecteur.classList.add("opacity-100");
      }, t);

      z.regles.forEach(function (regle) {
        t += REGLE;
        planifier(function () {
          regle.classList.remove("opacity-0");
          regle.classList.add("opacity-100");
        }, t);
      });

      t += 200;
      planifier(function () {
        z.devis.classList.remove("opacity-0");
        z.devis.classList.add("opacity-100");
      }, t);

      z.lignes.concat([z.total]).forEach(function (el) {
        t += LIGNE;
        planifier(function () {
          el.classList.remove("opacity-0");
          el.classList.add("opacity-100");
        }, t);
      });

      t += 400;
      planifier(function () {
        porte.classList.remove("opacity-0");
        porte.classList.add("opacity-100");
      }, t);

      t += TENUE;
      planifier(suivant, t);
    }

    function suivant() {
      var sortante = scenes[index];
      index = (index + 1) % scenes.length;
      var entrante = scenes[index];

      porte.classList.add("opacity-0");
      porte.classList.remove("opacity-100");
      sortante.classList.add("opacity-0");
      sortante.classList.remove("opacity-100");

      masquer(entrante);
      planifier(function () {
        etiquette.textContent = entrante.dataset.metier;
        entrante.classList.remove("opacity-0");
        entrante.classList.add("opacity-100");
        jouer(entrante);
      }, BASCULE);
    }

    function demarrer() {
      if (enPause || !visible) return;
      if (premier) {
        premier = false;
        // L'état final du serveur reste à l'écran le temps d'être vu, puis la boucle prend la main.
        planifier(function () {
          masquer(scenes[0]);
          porte.classList.add("opacity-0");
          porte.classList.remove("opacity-100");
          planifier(function () {
            jouer(scenes[0]);
          }, 200);
        }, PREMIERE_TENUE);
      } else {
        masquer(scenes[index]);
        planifier(function () {
          jouer(scenes[index]);
        }, 200);
      }
    }

    bouton.addEventListener("click", function () {
      enPause = !enPause;
      bouton.setAttribute("aria-pressed", String(enPause));
      var libelle = enPause ? "Relancer l'animation" : "Mettre l'animation en pause";
      bouton.setAttribute("aria-label", libelle);
      bouton.setAttribute("title", libelle);
      iconePause.classList.toggle("hidden", enPause);
      iconeLecture.classList.toggle("hidden", !enPause);
      if (enPause) stopper();
      else demarrer();
    });

    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (entrees) {
        var etait = visible;
        visible = entrees[0].isIntersecting;
        if (!visible) stopper();
        else if (!etait) demarrer();
      }).observe(conteneur);
    }

    demarrer();
  })();
</script>
