---
import type { Question } from "../../config/faq";
type Props = { questions: Question[] };
const { questions } = Astro.props;
---
<div class="max-w-3xl divide-y divide-border border-y border-border">
  {
    questions.map((f) => (
      <details class="group py-5">
        <summary class="cursor-pointer text-18 font-medium">{f.q}</summary>
        <div class="mt-4 flex max-w-(--measure) flex-col gap-3 text-16 text-ink-muted">{f.a.map((p) => <p>{p}</p>)}</div>
      </details>
    ))
  }
</div>
