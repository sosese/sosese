---
import { casClient, lien } from "../../config/site";
import { preuve } from "../../config/editorial";
import CompareBars from "../ui/diagrams/CompareBars.astro";
import Button from "../ui/Button.astro";
import Citation from "./Citation.astro";
---
<section id="cas-client" aria-labelledby="preuve-titre" class="border-t border-border bg-bg-subtle py-(--section-y)">
  <div class="container-site grid gap-8 lg:grid-cols-2 lg:gap-12">
    <div class="flex flex-col gap-6">
      <div>
        <p class="eyebrow mb-3">Déjà en service · pose de sols</p>
        <h2 id="preuve-titre" class="text-28 font-semibold md:text-36">Chez L’Atelier des Sols & Fils, le devis part du chantier.</h2>
      </div>
      <p class="text-18 text-ink-muted">
        {casClient.prenom} dicte la demande sur place. Le devis est préparé dans {casClient.logiciel}, aux prix du catalogue de l’entreprise, puis créé après son « oui ».
      </p>
      <Citation />
      <div class="flex flex-wrap items-center gap-4">
        <span class="section-invert rounded-md bg-bg px-4 py-3"><img src={lien(casClient.logo!)} alt={casClient.nom} width="160" height="40" loading="lazy" class="h-10 w-auto" /></span>
        <Button href={lien("/realisations/atelier-sols-fils")} variant="secondary">Voir ce qui a été fait <span aria-hidden="true">→</span></Button>
      </div>
    </div>
    <div class="rounded-lg border border-border bg-surface p-6 md:p-8">
      <h3 class="mb-6 text-21 font-semibold">Le temps d’un devis</h3>
      <CompareBars bars={[...preuve.devis]} />
      <dl class="mt-6 grid grid-cols-3 gap-4 border-t border-border pt-5">
        {preuve.production.map((p) => <div><dd class="font-mono text-28">{p.valeur}</dd><dt class="mt-1 text-14 text-ink-muted">{p.label}</dt></div>)}
      </dl>
      <p class="mt-5 text-14 text-ink-muted">En six semaines d’utilisation. Chiffres communiqués par l’entreprise.</p>
    </div>
  </div>
</section>
