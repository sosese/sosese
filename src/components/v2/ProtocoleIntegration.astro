  /* — Déroulé — */
  @media (prefers-reduced-motion: no-preference) {
    /* La sortie du client : l'objet descend, longe le canal et remonte jusqu'au serveur. Trois
       segments orthogonaux, et le temps de les parcourir — c'est ce trajet qui dit que le
       protocole est une frontière et pas un simple trait. */
    .flux[data-etape="4"] .objet {
      animation: flux-sortie 1100ms var(--ease-out) both;
    }
    .flux[data-etape="5"] .objet {
      animation: flux-entree 900ms var(--ease-out) both;
    }
    /* L'éclat : un morceau par route, décalés, et la réponse qui revient les refusionner. */
