    }
    /* Le retour de la normalisation vers le client, puis la boucle complète du second objectif. */
    .flux[data-etape="10"] .objet {
      animation: flux-rentre 900ms var(--ease-out) both;
    }
    .flux[data-etape="11"] .objet {
      animation: flux-boucle 3600ms var(--ease-out) both;
    }
