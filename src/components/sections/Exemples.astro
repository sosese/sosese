---
import { getCollection } from "astro:content";
import Card from "../ui/Card.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import MicroFlux from "../ui/diagrams/MicroFlux.astro";
import { cta } from "../../config/site";

const exemples = (await getCollection("exemples")).sort((a, b) => a.data.ordre - b.data.ordre);
---

<section id="exemples" aria-labelledby="exemples-titre" class="border-t border-border py-(--section-y)">
  <div class="container-site flex flex-col gap-12">
    <SectionHeading id="exemples-titre" eyebrow="Exemples illustratifs" title="À quoi ça ressemble, concrètement">
      Des cas types, pas des missions clients. Les gains sont des ordres de grandeur : le vôtre est estimé
      pendant l'atelier.
    </SectionHeading>

    <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        exemples.map(({ data }) => (
          <li class="flex">
            <Card interactive class="flex w-full flex-col gap-4">
              <h3 class="text-18 font-semibold">{data.titre}</h3>
              <MicroFlux steps={data.flux} label={`Étapes : ${data.flux.join(", puis ")}`} />
              <p class="text-14 text-ink-muted">{data.apres}</p>
              <p class="mt-auto flex items-baseline gap-2 border-t border-border pt-4 font-mono text-14 text-accent">
                <span aria-hidden="true">→</span>
                <span>{data.gain}</span>
              </p>
            </Card>
          </li>
        ))
      }
      <li class="flex">
        <a
          href={cta.href}
          class="group/cta flex w-full flex-col justify-between gap-6 rounded-lg border border-dashed border-border-strong p-6 transition-[border-color,transform] duration-(--duration-base) ease-out hover:border-accent motion-safe:hover:-translate-y-0.5"
        >
          <div class="flex flex-col gap-3">
            <h3 class="text-18 font-semibold">Un processus qui vous coûte du temps ?</h3>
            <p class="text-14 text-ink-muted">Décrivez-le. On vous dit franchement s'il se prête à l'automatisation.</p>
          </div>
          <span class="font-mono text-14 text-accent">
            {cta.label} <span aria-hidden="true" class="inline-block transition-transform duration-(--duration-fast) ease-out motion-safe:group-hover/cta:translate-x-1">→</span>
          </span>
        </a>
      </li>
    </ul>
  </div>
</section>
