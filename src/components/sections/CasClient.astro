---
import Badge from "../ui/Badge.astro";
import Card from "../ui/Card.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import CompareBars from "../ui/diagrams/CompareBars.astro";
import Figure from "../ui/diagrams/Figure.astro";
import EnchainementClient from "../ui/diagrams/EnchainementClient.astro";

// Chiffres mesurés du cas réel (DESIGN.md, « Cas client »). Ne pas les modifier sans l'accord du client.
const tempsDevis = [
  {
    label: "Avant — ressaisi le soir, au bureau",
    value: 40,
    display: "40 min",
    note: "Le client attendait son chiffre 24 à 48 heures.",
    tone: "muted" as const,
  },
  {
    label: "Après — dicté sur le chantier",
    value: 2,
    display: "2 min",
    note: "Il l'a maintenant avant que le camion reparte.",
    tone: "accent" as const,
  },
];
---

<section id="cas-client" aria-labelledby="cas-client-titre" class="border-t border-border bg-bg-subtle py-(--section-y)">
  <div class="container-site flex flex-col gap-12">
    <div class="flex flex-col gap-4">
      <SectionHeading id="cas-client-titre" eyebrow="Cas client réel" title="Le devis part du chantier, pas du bureau">
        Chez L'Atelier des Sols &amp; Fils, poseur de sols, le chiffrage se fait désormais sur place.
      </SectionHeading>
      <Badge variant="accent" dot>L'Atelier des Sols &amp; Fils — pose de sols</Badge>
    </div>

    <div class="grid gap-8 lg:grid-cols-[3fr_2fr] lg:gap-12">
      <Card padding="lg">
        <Figure label="Le temps d'un devis" caption="Mesuré chez L'Atelier des Sols & Fils, sur leurs propres devis.">
          <CompareBars bars={tempsDevis} />
        </Figure>
      </Card>

      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
        <li class="flex">
          <Card class="flex w-full flex-col gap-2">
            <p class="font-mono text-36 text-accent">0</p>
            <p class="text-14 text-ink-muted">
              ressaisie : le métrage pris sur le chantier est celui qui part sur le devis
            </p>
          </Card>
        </li>
        <li class="flex">
          <Card class="flex w-full flex-col gap-2">
            <p class="font-mono text-36 text-accent">100 %</p>
            <p class="text-14 text-ink-muted">
              des devis créés après un accord explicite : le chiffrage est libre, l'écriture ne l'est jamais
            </p>
          </Card>
        </li>
      </ul>
    </div>

    <EnchainementClient />
  </div>
</section>
