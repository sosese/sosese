---
import DotPattern from "../ui/DotPattern.astro";
import SectionHeading from "../ui/SectionHeading.astro";

// À VALIDER : remplacer par la stack réellement utilisée (seul endroit où le jargon est autorisé, §2.1).
const technos = [
  { domaine: "Modèles", items: ["LLM via API, région UE", "modèles open-weight auto-hébergés", "OCR / extraction de documents"] },
  { domaine: "Intégration", items: ["API REST, webhooks", "connecteurs ERP / CRM", "IMAP / SMTP, SFTP"] },
  { domaine: "Données", items: ["RAG sur vos documents", "base vectorielle", "PostgreSQL"] },
  { domaine: "Orchestration", items: ["files de tâches, retries", "journalisation structurée", "alertes sur erreur"] },
  { domaine: "Infrastructure", items: ["conteneurs Docker", "hébergement UE", "secrets chiffrés"] },
  { domaine: "Contrôle", items: ["validation humaine configurable", "traçabilité des traitements", "tests de non-régression"] },
];

const blocs = [
  { titre: "Votre SI existant", items: ["ERP / gestion commerciale", "CRM", "messagerie", "fichiers partagés"] },
  { titre: "Couche d'intégration", items: ["connecteurs, API, webhooks", "file de tâches", "journal des traitements"], accent: true },
  { titre: "Traitements IA — UE", items: ["lecture de documents", "génération de brouillons", "recherche dans vos documents"] },
];
---

<section aria-labelledby="capot-titre" class="section-invert relative overflow-hidden border-y border-border py-(--section-y)">
  <DotPattern />
  <div class="container-site relative flex flex-col gap-12">
    <SectionHeading id="capot-titre" eyebrow="Pour votre responsable informatique" title="Sous le capot">
      Une architecture sobre, documentée et réversible, qui s'ajoute à votre système d'information sans le remplacer.
    </SectionHeading>

    <div class="flex flex-col gap-4">
      <p class="eyebrow">Schéma d'intégration</p>
      <ol class="grid items-stretch gap-2 lg:grid-cols-[1fr_auto_1fr_auto_1fr]">
        {
          blocs.map((bloc, i) => (
            <>
              <li class:list={["flex flex-col gap-3 rounded-lg border bg-surface p-6", bloc.accent ? "border-accent" : "border-border-strong"]}>
                <p class="font-mono text-14 text-ink">{bloc.titre}</p>
                <ul class="flex flex-col gap-1 font-mono text-12 text-ink-muted">
                  {bloc.items.map((item) => <li>{item}</li>)}
                </ul>
              </li>
              {i < blocs.length - 1 && (
                <li aria-hidden="true" class="flex items-center justify-center py-1 font-mono text-16 text-accent lg:px-2 lg:py-0">
                  <span class="lg:hidden">↕</span>
                  <span class="hidden lg:inline">⇄</span>
                </li>
              )}
            </>
          ))
        }
      </ol>
      <p class="font-mono text-12 text-ink-muted">
        Toute action sortante — envoi d'un email, écriture dans l'ERP — peut exiger une validation humaine.
      </p>
    </div>

    <ul class="grid gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
      {
        technos.map((t) => (
          <li class="flex flex-col gap-3 bg-bg p-6 transition-colors duration-(--duration-fast) ease-out hover:bg-bg-subtle">
            <p class="eyebrow">{t.domaine}</p>
            <ul class="flex flex-col gap-1 font-mono text-14 text-ink">
              {t.items.map((item) => <li>{item}</li>)}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
