---
import { existsSync, readFileSync } from "node:fs";
import { join } from "node:path";
import Badge from "../ui/Badge.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import EnchainementClient from "../ui/diagrams/EnchainementClient.astro";
import { casClient } from "../../config/site";

// Le logo du client est un fichier fourni par lui, déposé dans `public/` — exception assumée à la règle
// « schémas SVG, pas d'images » : l'identité d'un tiers ne se redessine pas (DESIGN.md, « Cas client »).
// Tant que le fichier n'est pas là, la section n'affiche que le nom : pas d'image cassée, jamais de
// logo reconstitué.
// `process.cwd()` et non `import.meta.url` : au build, ce module est un chunk, son URL ne pointe
// plus sur les sources. Astro se lance toujours depuis la racine du projet.
const fichierLogo = casClient.logo ? join(process.cwd(), "public", casClient.logo) : null;
const logo = fichierLogo && existsSync(fichierLogo) ? casClient.logo : null;

// Hauteur de rendu fixée ; la largeur est déduite du `viewBox` du SVG pour réserver la place (CLS 0).
const HAUTEUR_LOGO = 40;
const viewBox = logo?.endsWith(".svg")
  ? readFileSync(fichierLogo!, "utf8").match(/viewBox="[\d.\s-]*?([\d.]+)\s+([\d.]+)"/)
  : null;
const largeurLogo = viewBox ? Math.round((HAUTEUR_LOGO * Number(viewBox[1])) / Number(viewBox[2])) : undefined;
---

<section id="cas-client" aria-labelledby="cas-client-titre" class="py-(--section-y)">
  <div class="container-site flex flex-col gap-8">
    <div>
      <div class="flex flex-col gap-5">
        <SectionHeading id="cas-client-titre" eyebrow="Clients" title="Ils nous ont fait confiance">
          Connecteur IA sur mesure pour le logiciel commercial.
        </SectionHeading>

        {/* Nom, logo et lien publiés avec l'accord du client. Un seul lien pour les deux : le logo est
            décoratif (`alt` vide), le nom porte la destination.
            Le logo du client est un lettrage blanc sur fond transparent : il disparaîtrait sur le fond
            clair. Il est posé sur une plaque `section-invert` — sombre dans les deux thèmes, comme le
            terminal — plutôt que retouché. */}
        <div class="flex flex-wrap items-center gap-4">
          {
            logo && (
              <span class="section-invert inline-flex items-center rounded-md px-4 py-3">
                <img src={logo} alt="" height={HAUTEUR_LOGO} width={largeurLogo} loading="lazy" decoding="async" class="h-10 w-auto" />
              </span>
            )
          }
          <Badge variant="accent" dot={!logo} href={casClient.site}>
            {casClient.nom} — {casClient.metier} <span aria-hidden="true">↗</span>
          </Badge>
        </div>

        {/* Le titre du cas descend en h3 : la section parle des clients, le devis sur le chantier n'en
            est qu'un exemple. Hiérarchie : h2 de section, h3 du cas. */}
        <h3 class="max-w-(--measure) text-21 font-semibold tracking-tight md:text-28">
          Le devis part du chantier, pas du bureau
        </h3>
        <p class="max-w-(--measure) text-18 text-ink-muted">
          Chez {casClient.nom}, {casClient.prenom}, commercial, chiffre maintenant sur place.{" "}
          {casClient.logiciel && (
            <Fragment>
              La solution lit leur catalogue et leurs tarifs dans {casClient.logiciel}, et y crée devis,
              rendez-vous et fiches clients — une fois qu'ils ont dit oui.
            </Fragment>
          )}
        </p>
      </div>

    </div>

    <EnchainementClient />
  </div>
</section>
