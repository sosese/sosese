---
import SectionHeading from "../ui/SectionHeading.astro";
import PastilleIcone from "../ui/PastilleIcone.astro";
import Temoignage from "../ui/Temoignage.astro";
import CompareBars from "../ui/diagrams/CompareBars.astro";
import EnchainementClient from "../ui/diagrams/EnchainementClient.astro";
import { casClient } from "../../config/site";

// Tout ce qui suit vient du formulaire de satisfaction rempli par le client (DESIGN.md, « Le cas ») :
// ses phrases, retouchées pour l'orthographe seulement et avec son accord, et ses deux chiffres.
// Rien n'est lu dans un outil connecté, rien n'est estimé par sosese (piège 17). Ses retours privés
// ne se publient pas. Ne rien ajouter ici sans le même accord.
const citation =
  "Joris a su comprendre nos besoins lors de son expertise et y apporter des réponses et des automatisations que j'utilise maintenant au quotidien.";

// Sa phrase « avant / après », coupée en deux pour se lire côte à côte, et ce que le temps gagné lui permet.
const avant = "Je créais tout dans mon logiciel.";
const aujourdhui = "L'assistant s'en charge et je ne fais plus que consulter. Un gain de temps énorme.";
const tempsGagne =
  "Je travaille sur d'autres projets, je suis plus réactif pour envoyer les devis à mes clients, et ma direction a un meilleur suivi.";

// Deux chiffres, pas un de plus : ceux qu'il a donnés. Pas les 2 h d'administratif d'avant (il faudrait
// expliquer pourquoi il en gagne 4 : l'assistant fait aussi du suivi commercial), pas sa note.
// Le devis en comparaison de grandeurs (R3) : les valeurs sont écrites, les barres ne font que les
// mettre en proportion.
const devis = [
  { label: "Avant", value: 25, display: "25 min", tone: "muted" as const },
  { label: "Avec l'assistant", value: 3, display: "3 min", tone: "accent" as const },
];

// Tracés des pastilles d'icônes (24 × 24, trait) : chaînes statiques, décoratives, le texte est à côté.
const icones = {
  bureau: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
  telephone: '<rect x="7" y="3" width="10" height="18" rx="2"/><path d="M11 17h2"/>',
  deplacement: '<path d="M5 17H3v-5l2-1 2.5-5h9l2.5 5 2 1v5h-2M9 17h6M5 11h14"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/>',
  horloge: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  saisie: '<path d="M4 20h4L19 9l-4-4L4 16z"/><path d="m13 7 4 4"/>',
  coche: '<path d="m5 12 5 5 9-10"/>',
  projets: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="M12 10.5v5M9.5 13h5"/>',
  envoi: '<path d="M21 3 3 10.5l7 2.5 2.5 7z"/><path d="m10 13 4.5-4.5"/>',
  suivi: '<path d="M4 4v16h16"/><path d="m8 14 3-3 3 2 5-5"/>',
};

// Ce que le temps gagné lui permet : sa phrase, reprise en trois points sans rien ajouter.
const gains = [
  { icone: icones.projets, texte: "D'autres projets" },
  { icone: icones.envoi, texte: "Des devis envoyés plus vite" },
  { icone: icones.suivi, texte: "Un meilleur suivi pour sa direction" },
];

// Son usage, tel qu'il l'a décrit : « plusieurs fois par jour, au bureau, au téléphone et en déplacement ».
// Une donnée de son formulaire, pas un chiffre de plus.
const lieux = [
  { icone: icones.bureau, texte: "au bureau" },
  { icone: icones.telephone, texte: "au téléphone" },
  { icone: icones.deplacement, texte: "en déplacement" },
];

const guillemets = (texte: string) => `« ${texte} »`;
---

<section id="cas-client" aria-labelledby="cas-client-titre" class="py-(--section-y)">
  <div class="container-site flex flex-col gap-12">
    <SectionHeading id="cas-client-titre" eyebrow="Clients" title={`Ce qu'en dit ${casClient.prenom}, chez ${casClient.nom}`}>
      {/* Le nom de l'entreprise est déjà dans le titre et la signature : « Son entreprise » ici. Le déroulé
          (demande, préparation, vérification) n'est plus raconté : la démonstration plus bas le montre. */}
      Son entreprise pose des sols entre Metz et le Luxembourg, avec une équipe de 4 à 9 personnes. J'y ai
      construit un assistant relié à{" "}
      {casClient.logiciel ? `${casClient.logiciel}, leur logiciel de gestion` : "leur logiciel de gestion"}.
    </SectionHeading>

    <Temoignage
      citation={citation}
      prenom={casClient.prenom}
      nomFamille={casClient.nomFamille}
      role={casClient.role}
      entreprise={casClient.nom}
      site={casClient.site}
      logo={casClient.logo}
    />

    {/* Les chiffres d'abord dans le DOM : empilés sur mobile, ils se lisent juste sous la citation.
        Une carte « ce qu'il en tire » : son usage, le devis en barres, le temps gagné en grand. */}
    <div class="grid items-start gap-6 lg:grid-cols-[2fr_3fr]">
      <div class="flex flex-col gap-8 rounded-lg border border-border bg-surface p-6 shadow-sm">
        <div class="flex flex-col gap-3">
          {/* « Jason » et non « il » : juste après la citation, « il » pourrait se lire comme l'assistant. */}
          <p class="text-16 text-ink">{casClient.prenom} s'en sert plusieurs fois par jour :</p>
          <ul class="flex flex-wrap gap-x-6 gap-y-3">
            {
              lieux.map((lieu) => (
                <li class="flex items-center gap-2 text-16 text-ink">
                  <PastilleIcone trace={lieu.icone} />
                  {lieu.texte}
                </li>
              ))
            }
          </ul>
        </div>

        <dl class="flex flex-col gap-8">
          <div class="flex flex-col gap-3">
            <dt class="text-14 text-ink-muted">Pour un devis</dt>
            <dd><CompareBars bars={devis} reveal /></dd>
          </div>
          <div class="flex flex-col gap-1">
            <dt class="text-14 text-ink-muted">Gagnées par semaine</dt>
            <dd class="flex items-center gap-4">
              <PastilleIcone trace={icones.horloge} />
              <span class="font-display text-36 leading-(--leading-tight) text-accent tabular-nums md:text-48">
                <span aria-hidden="true">≈ </span>
                <span class="sr-only">environ </span>
                4 h
              </span>
            </dd>
          </div>
        </dl>
      </div>

      <div class="flex flex-col gap-8 rounded-lg border border-border bg-surface p-6 shadow-sm">
        {/* Avant → Aujourd'hui en flux (R1) : deux cases dans la carte (comme les temps de la démonstration),
            reliées par une flèche, verticale sous `sm`. « Avant » neutre, « Aujourd'hui » bordée d'accent. */}
        <div class="grid gap-3 sm:grid-cols-[1fr_auto_1fr]">
          <div class="flex flex-col gap-3 rounded-md border border-border bg-bg p-4">
            <div class="flex items-center gap-3">
              <PastilleIcone trace={icones.saisie} ton="neutre" />
              <p class="eyebrow">Avant</p>
            </div>
            <blockquote class="text-16 text-ink">
              <p>{guillemets(avant)}</p>
            </blockquote>
          </div>
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="size-6 rotate-90 self-center justify-self-center text-accent sm:rotate-0"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
          <div class="flex flex-col gap-3 rounded-md border border-accent bg-bg p-4">
            <div class="flex items-center gap-3">
              <PastilleIcone trace={icones.coche} />
              <p class="eyebrow text-accent">Aujourd'hui</p>
            </div>
            <blockquote class="text-16 text-ink">
              <p>{guillemets(aujourdhui)}</p>
            </blockquote>
          </div>
        </div>

        {/* Le temps gagné : trois points à icône qui reprennent sa phrase, puis la phrase elle-même. */}
        <div class="flex flex-col gap-4">
          <p class="eyebrow">Le temps gagné</p>
          <ul class="flex flex-col gap-3">
            {
              gains.map((gain) => (
                <li class="flex items-center gap-3 text-16 font-semibold text-ink">
                  <PastilleIcone trace={gain.icone} />
                  {gain.texte}
                </li>
              ))
            }
          </ul>
          <blockquote class="text-16 text-ink-muted">
            <p>{guillemets(tempsGagne)}</p>
          </blockquote>
        </div>
      </div>
    </div>

    <EnchainementClient />
  </div>
</section>
