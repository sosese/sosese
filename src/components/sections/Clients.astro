---
import SectionHeading from "../ui/SectionHeading.astro";
import Temoignage from "../ui/Temoignage.astro";
import EnchainementClient from "../ui/diagrams/EnchainementClient.astro";
import { casClient } from "../../config/site";

// Tout ce qui suit vient du formulaire de satisfaction rempli par le client (DESIGN.md, « Le cas ») :
// ses phrases, retouchées pour l'orthographe seulement et avec son accord, et ses deux chiffres.
// Rien n'est lu dans un outil connecté, rien n'est estimé par sosese (piège 17). Ses retours privés
// ne se publient pas. Ne rien ajouter ici sans le même accord.
const citation =
  "Joris a su comprendre nos besoins lors de son expertise et y apporter des réponses et des automatisations que j'utilise maintenant au quotidien.";

// Sa phrase « avant / après », coupée en deux pour se lire côte à côte, et ce que le temps gagné lui permet.
const avantApres = [
  { label: "Avant", texte: "Je créais tout dans mon logiciel." },
  { label: "Aujourd'hui", texte: "L'assistant s'en charge et je ne fais plus que consulter. Un gain de temps énorme." },
];
const tempsGagne =
  "Je travaille sur d'autres projets, je suis plus réactif pour envoyer les devis à mes clients, et ma direction a un meilleur suivi.";

// Deux chiffres, pas un de plus : ceux qu'il a donnés. Pas les 2 h d'administratif d'avant (il faudrait
// expliquer pourquoi il en gagne 4 : l'assistant fait aussi du suivi commercial), pas sa note.
const chiffres = [
  { label: "Pour un devis", avant: "25 min", apres: "3 min" },
  { label: "Gagnées par semaine", environ: true, valeur: "4 h" },
];

const guillemets = (texte: string) => `« ${texte} »`;
---

<section id="cas-client" aria-labelledby="cas-client-titre" class="py-(--section-y)">
  <div class="container-site flex flex-col gap-8">
    <SectionHeading id="cas-client-titre" eyebrow="Clients" title={`Ce qu'en dit ${casClient.prenom}, chez ${casClient.nom}`}>
      {/* Le nom de l'entreprise est déjà dans le titre et la signature : « Son entreprise » ici. Jason est
          nommé comme sujet de chaque geste, pour que « il » ne se rattache jamais à l'assistant. */}
      Son entreprise pose des sols entre Metz et le Luxembourg, avec une équipe de 4 à 9 personnes. J'y ai
      construit un assistant relié à{" "}
      {casClient.logiciel ? `${casClient.logiciel}, leur logiciel de gestion` : "leur logiciel de gestion"} :{" "}
      {casClient.prenom} demande le devis, le devis se prépare dans le logiciel, {casClient.prenom} le vérifie, et
      c'est enregistré.
    </SectionHeading>

    <Temoignage
      citation={citation}
      prenom={casClient.prenom}
      nomFamille={casClient.nomFamille}
      role={casClient.role}
      entreprise={casClient.nom}
      site={casClient.site}
      logo={casClient.logo}
    />

    {/* Les chiffres d'abord dans le DOM : empilés sur mobile, ils se lisent juste sous la citation.
        Sobres : pas de grille de compteurs, pas de couleur d'accent, la valeur et son libellé. */}
    <div class="grid items-start gap-6 lg:grid-cols-[2fr_3fr]">
      <div class="flex flex-col gap-6 rounded-lg border border-border bg-surface p-6 shadow-sm">
        <dl class="flex flex-col gap-6">
          {
            chiffres.map((chiffre) => (
              <div class="flex flex-col gap-1">
                <dt class="text-14 text-ink-muted">{chiffre.label}</dt>
                <dd class="font-display text-28 text-ink tabular-nums md:text-36">
                  {"avant" in chiffre ? (
                    <Fragment>
                      {/* Lu « avant 25 min, maintenant 3 min » : la flèche seule ne dit pas le sens. */}
                      <span class="sr-only">avant </span>
                      {chiffre.avant} <span aria-hidden="true" class="font-sans text-ink-muted">→</span>
                      <span class="sr-only">, maintenant </span>
                      {chiffre.apres}
                    </Fragment>
                  ) : (
                    <Fragment>
                      <span aria-hidden="true">≈ </span>
                      <span class="sr-only">environ </span>
                      {chiffre.valeur}
                    </Fragment>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="text-14 text-ink-muted">Selon {casClient.prenom}.</p>
      </div>

      <figure class="flex flex-col gap-6 rounded-lg border border-border bg-surface p-6 shadow-sm">
        <div class="grid gap-6 sm:grid-cols-2">
          {
            avantApres.map((temps) => (
              <div class="flex flex-col gap-2">
                <p class="eyebrow">{temps.label}</p>
                <blockquote class="text-18 text-ink">
                  <p>{guillemets(temps.texte)}</p>
                </blockquote>
              </div>
            ))
          }
        </div>
        <div class="flex flex-col gap-2 border-t border-border pt-6">
          <p class="eyebrow">Le temps gagné</p>
          <blockquote class="text-18 text-ink">
            <p>{guillemets(tempsGagne)}</p>
          </blockquote>
        </div>
        <figcaption class="text-14 text-ink-muted">{casClient.prenom}, dans ses mots.</figcaption>
      </figure>
    </div>

    <EnchainementClient />
  </div>
</section>
