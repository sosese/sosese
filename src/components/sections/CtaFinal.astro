---
import Button from "../ui/Button.astro";
import DotPattern from "../ui/DotPattern.astro";
import { cta } from "../../config/site";
---

<section aria-labelledby="cta-titre" class="section-invert relative overflow-hidden border-y border-border py-(--section-y)">
  <DotPattern />
  <div class="container-site relative flex flex-col items-center gap-6 text-center">
    <p class="eyebrow">Prochaine étape</p>
    <h2 id="cta-titre" class="max-w-(--measure) text-36 font-semibold tracking-tight md:text-48">
      Vos tâches répétitives, automatisées. <span class="text-ink-muted">Sans changer vos outils.</span>
    </h2>
    <p class="max-w-(--measure) text-18 text-ink-muted">
      Dites-nous où votre équipe perd du temps. On vous répond franchement : ce qui vaut la peine d'être automatisé,
      et ce qui ne le vaut pas.
    </p>
    <div class="pt-2">
      <Button href={cta.href} size="lg">
        {cta.label}
        <span aria-hidden="true" class="font-mono transition-transform duration-(--duration-fast) ease-out motion-safe:group-hover/button:translate-x-0.5">→</span>
      </Button>
    </div>
  </div>
</section>
