---
import Button from "../ui/Button.astro";
import { cta } from "../../config/site";
---

<!-- aria-label distinct du titre : deux régions de page ne peuvent pas porter le même nom accessible.
     Sans motif de points depuis le 2026-10-08 (étape 5) : le décor technique reste dans « Sous le capot ». -->
<section aria-label="Prochaine étape" class="section-invert border-y border-border py-(--section-y)">
  <div class="container-site flex flex-col items-center gap-6 text-center">
    <p class="eyebrow text-accent">Prochaine étape</p>
    <h2 id="cta-titre" class="max-w-(--measure) text-36 font-semibold tracking-tight md:text-48">
      Qu'est-ce qui vous prend <span class="text-ink-muted">le plus de temps ?</span>
    </h2>
    <p class="max-w-(--measure) text-18 text-ink-muted">
      Dites-le-moi. Je vous réponds franchement : ce qu'un assistant peut prendre en charge chez vous, et ce
      qui n'en vaut pas la peine.
    </p>
    <div class="pt-2">
      <Button href={cta.href} size="lg">
        {cta.label}
        <span aria-hidden="true" class="transition-transform duration-(--duration-fast) ease-out motion-safe:group-hover/button:translate-x-0.5">→</span>
      </Button>
    </div>
  </div>
</section>
