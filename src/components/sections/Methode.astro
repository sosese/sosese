---
import SectionHeading from "../ui/SectionHeading.astro";
import CompareBars from "../ui/diagrams/CompareBars.astro";
import Figure from "../ui/diagrams/Figure.astro";

// À VALIDER : durées, livrables et temps demandé au client (§5 ligne 4, contenu non fourni par le §9).
// `jours` sert uniquement aux proportions du schéma : il doit rester cohérent avec `duree`.
const etapes = [
  {
    titre: "Atelier",
    duree: "2 jours",
    dureeCourte: "2 j",
    jours: 2,
    livrable: "Cartographie des processus et diagnostic",
    texte: "Sur site, avec les personnes qui font le travail. On cartographie vos processus et on repère ce qui peut être automatisé.",
    tempsClient: "2 jours avec les équipes concernées",
  },
  {
    titre: "Feuille de route",
    duree: "1 semaine",
    dureeCourte: "1 sem.",
    jours: 5,
    livrable: "Feuille de route chiffrée et priorisée",
    texte: "Chaque piste est chiffrée : temps gagné, coût, faisabilité. Vous choisissez par quoi commencer, et si vous continuez.",
    tempsClient: "1 heure de restitution",
  },
  {
    titre: "Construction",
    duree: "4 semaines",
    dureeCourte: "4 sem.",
    jours: 20,
    livrable: "Solution en service, documentée, code et accès remis",
    texte: "On construit la solution retenue, branchée sur vos outils, puis on la met en service avec vos équipes.",
    tempsClient: "1 heure de point par semaine",
  },
];

// 27 jours de projet, dont 2 jours d'atelier + 1 h de restitution + 4 h de points ≈ 2,7 jours pour vous.
const charge = [
  { label: "Durée du projet", value: 27, display: "≈ 6 semaines", tone: "muted" as const },
  {
    label: "Votre temps sur la période",
    value: 2.7,
    display: "moins de 3 jours",
    note: "Les 2 jours d'atelier, puis une heure de point par semaine.",
    tone: "accent" as const,
  },
];
---

<section id="methode" aria-labelledby="methode-titre" class="border-y border-border bg-bg-subtle py-(--section-y)">
  <div class="container-site flex flex-col gap-12">
    <SectionHeading id="methode-titre" eyebrow="La méthode" title="Trois étapes, un livrable concret à chacune">
      Vous décidez de la suite à la fin de chaque étape.
    </SectionHeading>

    <Figure label="Déroulé d'un projet" caption="Durées indicatives, arrêtées avec vous à la fin de l'atelier.">
      <div class="flex flex-col gap-6">
        <!-- Barre proportionnelle : décorative, tout est repris dans les étapes ci-dessous. -->
        <ol aria-hidden="true" class="bar-grow flex origin-left gap-2">
          {
            etapes.map((etape) => (
              <li class="flex basis-0 flex-col gap-2" style={`flex-grow: ${etape.jours}`}>
                <span class="h-3 rounded-full bg-accent"></span>
                <span class="font-mono text-12 text-ink-muted">{etape.dureeCourte}</span>
              </li>
            ))
          }
        </ol>

        <ol class="grid gap-4 md:grid-cols-3">
          {
            etapes.map((etape, i) => (
              <li class="flex flex-col gap-3 rounded-lg border border-border bg-surface p-6">
                <span class="font-mono text-12 text-accent">0{i + 1}</span>
                <h3 class="text-21 font-semibold">{etape.titre}</h3>
                <p class="font-mono text-14 text-ink-muted">{etape.duree}</p>
                <p class="mt-auto border-t border-border pt-4 text-14 text-ink">{etape.livrable}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </Figure>

    <div class="grid gap-8 lg:grid-cols-[3fr_2fr] lg:items-start lg:gap-12">
      <Figure label="Ce que ça vous demande" class="rounded-lg border border-border bg-surface p-6 sm:p-8">
        <CompareBars bars={charge} />
      </Figure>

      <details class="group rounded-lg border border-border bg-surface">
        <summary
          class="flex cursor-pointer list-none items-center justify-between gap-6 p-6 text-18 font-medium text-ink transition-colors duration-(--duration-fast) ease-out hover:text-accent-hover [&::-webkit-details-marker]:hidden"
        >
          <span>Le détail de chaque étape</span>
          <span
            aria-hidden="true"
            class="flex size-8 shrink-0 items-center justify-center rounded-full border border-border font-mono text-16 text-ink-muted transition-transform duration-(--duration-base) ease-out group-open:rotate-45"
          >
            +
          </span>
        </summary>
        <dl class="flex flex-col gap-6 px-6 pb-6 text-14">
          {
            etapes.map((etape) => (
              <div class="flex flex-col gap-1">
                <dt class="font-medium text-ink">{etape.titre}</dt>
                <dd class="text-ink-muted">{etape.texte}</dd>
                <dd class="font-mono text-12 text-ink-muted">Votre temps : {etape.tempsClient}</dd>
              </div>
            ))
          }
        </dl>
      </details>
    </div>
  </div>
</section>
