---
import SectionHeading from "../ui/SectionHeading.astro";

// À VALIDER : durées, livrables et temps demandé au client (§5 ligne 4, contenu non fourni par le §9).
const etapes = [
  // Titres : des noms courts, pas des phrases. On survole ces trois mots ; la phrase d'action ouvre la
  // description (2026-09-19). Durées et temps demandé au client inchangés.
  {
    titre: "Atelier",
    texte: "On étudie comment vous travaillez avec vos équipes sur le terrain. On identifie les tâches chronophages et les meilleurs candidats à l'automatisation IA",
    duree: "2 jours",
    livrable: "le déroulé de vos processus, et où ça coince",
    tempsClient: "une demi-journée avec vos équipes",
  },
  {
    titre: "Feuille de route",
    texte: "On vous dit ce qui mérite d'être fait. On mesure le temps gagné, le coût et la faisabilité. Vous choisissez par quoi commencer.",
    duree: "1 semaine",
    livrable: "liste chiffrée, dans l'ordre où on la ferait",
    tempsClient: "1 heure pour en parler",
  },
  {
    titre: "Construction",
    texte: "On construit, et on branche. Ce que vous avez choisi, sur vos outils actuels, puis entre les mains de vos équipes. Vous voyez avancer chaque semaine.",
    duree: "4 semaines",
    livrable: "solution en service, avec mode d'emploi",
    tempsClient: "1 heure de point par semaine",
  },
];
---

<section id="methode" aria-labelledby="methode-titre" class="border-y border-border bg-bg-subtle py-(--section-y)">
  <div class="container-site flex flex-col gap-12">
    <SectionHeading id="methode-titre" eyebrow="Comment on travaille" title="Trois étapes, et vous décidez à la fin de chacune">
      Rien ne se construit avant que vous ayez vu, en face, ce que ça coûte et ce que ça rapporte.
    </SectionHeading>

    <ol data-methode class="grid gap-8 md:grid-cols-3 md:gap-6">
      {
        etapes.map((etape, i) => (
          <li class="relative flex gap-4 md:flex-col md:gap-6">
            <div class="flex flex-col items-center md:flex-row">
              <span data-revele class="relative z-10 flex size-10 shrink-0 items-center justify-center rounded-full border border-accent bg-surface font-mono text-14 text-accent">
                {i + 1}
              </span>
              {i < etapes.length - 1 && (
                <span aria-hidden="true" data-revele="trait" class="w-px flex-1 bg-border-strong md:-mr-6 md:h-px md:w-auto" />
              )}
            </div>

            <div class="flex flex-1 flex-col gap-4 pb-2 md:pr-4">
              <div data-revele class="flex flex-col gap-2">
                <h3 class="text-21 font-semibold">{etape.titre}</h3>
                <p class="text-16 text-ink-muted">{etape.texte}</p>
              </div>
              <dl data-revele class="flex flex-col divide-y divide-border rounded-md border border-border bg-surface text-14">
                <div class="flex flex-col gap-1 px-4 py-3">
                  <dt class="eyebrow">Votre temps</dt>
                  <dd class="text-ink">{etape.tempsClient}</dd>
                </div>
                <div data-revele class="flex flex-col gap-1 px-4 py-3">
                  <dt class="eyebrow">Durée</dt>
                  <dd class="font-mono text-ink">{etape.duree}</dd>
                </div>
                <div data-revele class="flex flex-col gap-1 px-4 py-3">
                  <dt class="eyebrow">Vous recevez</dt>
                  <dd class="text-ink">{etape.livrable}</dd>
                </div>
              </dl>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  // Révèle les trois étapes l'une après l'autre, de gauche à droite : pastille, texte, puis le détail
  // ligne par ligne (le cadre arrive avec la première, jamais vide), puis le trait vers l'étape
  // suivante. L'ordre du DOM est l'ordre de lecture.
  // Sans JS ou sous mouvement réduit, rien n'est masqué. Une seule lecture, au premier passage.
  (function () {
    var liste = document.querySelector("[data-methode]");
    if (!liste || !("IntersectionObserver" in window)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    var PAS = 260; // entre deux éléments
    var PAS_TRAIT = 420; // le trait qui mène à l'étape suivante
    var elements = Array.prototype.slice.call(liste.querySelectorAll("[data-revele]"));
    elements.forEach(function (el) {
      el.classList.add("revele-cache");
    });

    var observateur = new IntersectionObserver(
      function (entrees) {
        if (!entrees[0].isIntersecting) return;
        observateur.disconnect();
        var t = 0;
        elements.forEach(function (el) {
          t += el.dataset.revele === "trait" ? PAS_TRAIT : PAS;
          window.setTimeout(function () {
            el.classList.remove("revele-cache");
          }, t);
        });
      },
      { threshold: 0.25 },
    );
    observateur.observe(liste);
  })();
</script>
