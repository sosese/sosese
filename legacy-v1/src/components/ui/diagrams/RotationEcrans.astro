---
// Mockup animé de « L'offre » depuis le 2026-09-19 (visuel du hero le même jour, remplacé par
// VracEnActions). Posé en face des arguments, il y prouve « pas un logiciel de plus ».
// Le travail préparé arrive là où la personne se trouve déjà : le même
// enchaînement — une demande arrive, la solution consulte les outils de l'entreprise un par un en
// montrant ce qu'elle y trouve, une action prête à valider en sort — joué dans quatre décors et huit
// exemples : devis, nouveau client, rendez-vous, dépannage sous garantie, question de gestion,
// recherche dans l'historique, relances, analyse de ventes.
// Voir DESIGN.md, « Rotation d'écrans ».
//
// Contrat, identique aux autres mockups (terminal, DicteeMobile, cas client) :
// - l'état rendu par le serveur est l'état FINAL du premier écran : lisible sans JS, aucun flash ;
// - les quatre écrans sont empilés dans une même cellule de grille et toujours présents :
//   hauteur constante, CLS 0 au changement d'écran ;
// - bloc animé en aria-hidden, transcription complète en sr-only ;
// - la rotation tourne en boucle et dure plus de 5 s : bouton pause obligatoire (WCAG 2.2.2),
//   rendu hors mouvement réduit. Ne jamais le retirer. La pause est une VRAIE pause : elle gèle les
//   animations CSS (`data-fige`) et garde le reliquat du minuteur, donc la lecture repart à
//   l'instant exact où elle s'est arrêtée — jamais au début de l'exemple.
// - sous prefers-reduced-motion : aucune rotation automatique, aucune séquence ; les boutons
//   changent d'écran et l'écran arrive directement dans son état final.
//
// Données inventées (DESIGN.md, piège 17) : noms, dates et montants sont des exemples. Les outils
// consultés restent des catégories — « votre catalogue », « votre planning », « vos fiches
// clients », « votre comptabilité » — jamais une marque de logiciel.
// Quatre décors, deux exemples chacun : huit écrans au total, joués dans l'ordre du tableau
// `scenes` (un décor n'apparaît jamais deux fois de suite). Un clic sur un libellé va au premier
// exemple de ce décor, un deuxième clic passe à l'autre.
//
// Libellés courts : les quatre, plus le bouton de lecture, tiennent sur une seule ligne sous la
// maquette, y compris à 360 px (mono 12 : ~7,2 px par caractère, 24 rem de large). Un libellé plus
// long les fait passer à deux lignes. Le `titre` dit la phrase entière, en survol et pour les
// lecteurs d'écran.
const ecrans = [
  { label: "Messagerie", titre: "la messagerie de l'équipe", scenes: [0, 4] },
  { label: "Boîte mail", titre: "la boîte mail", scenes: [1, 5] },
  { label: "Téléphone", titre: "une notification sur le téléphone", scenes: [2, 6] },
  { label: "Gestion", titre: "l'application de gestion", scenes: [3, 7] },
];
---

<figure data-rotation class="rotation flex w-full max-w-lg flex-col gap-3 justify-self-center lg:justify-self-end">
  <div class="cv-piste" aria-hidden="true">
    <!-- L'assistant dans la messagerie de l'équipe : une cliente demande un chiffrage. -->
    <div class="cv-scene conv" data-ecran="0" data-etape="4" data-actif><header class="barre"><span class="cv-avatar">S</span><div><b>Votre assistant</b><i>en ligne</i></div><span class="menu">•••</span></header><div class="cv-corps"><div class="cv-vue fil" data-c="0"><div class="recu"><span class="cv-avatar">R</span><div class="bulle"><b>Mme Rivière</b><p>Pouvez-vous me chiffrer le remplacement du sol du magasin ?</p><span class="heure">09:12</span></div></div><div class="repondu"><p class="cherche">Je me connecte à vos outils…</p><div class="cv-reflexion"><div class="cv-pas" style="--i:0"><span class="cv-etat"><span class="rond"></span><svg class="coche" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="var(--accent-soft)"></circle><path d="m5 8.2 2.2 2.2L11 6.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><div><b>Votre catalogue</b><i>3 postes trouvés, prix à jour</i></div></div><div class="cv-pas" style="--i:1"><span class="cv-etat"><span class="rond"></span><svg class="coche" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="var(--accent-soft)"></circle><path d="m5 8.2 2.2 2.2L11 6.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><div><b>Votre planning</b><i>libre à partir du 6 octobre</i></div></div></div><p class="dit">J'ai regardé votre catalogue et votre planning.</p><div class="carte"><b>Devis prêt à envoyer</b><i>3 postes chiffrés · intervention possible le 6 octobre</i><span class="cv-bouton">Envoyer le devis</span></div></div></div></div><footer class="saisie"><span class="champ">Écrivez un message…</span><span class="envoi"><svg viewBox="0 0 16 16" fill="none"><path d="M8 13V3M8 3 4 7M8 3l4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg></span></footer></div>

    <!-- La boîte mail : un client rappelle, la réponse est préparée dans une fenêtre de rédaction. -->
    <div class="cv-scene mail" data-ecran="1" data-etape="4"><header class="barre"><span class="burger"><i></i><i></i><i></i></span><span class="recherche"><svg viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="4.4" stroke="currentColor" stroke-width="1.5"></circle><path d="m10.4 10.4 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>Rechercher dans les messages</span><span class="cv-avatar">J</span></header><div class="cv-corps"><div class="cv-vue vue" data-c="1"><div class="ligne neuve"><span class="pastille vive"></span><div><b>M. Bonnet</b><i>Appel de ce matin</i><em>Il rappelle pour avancer la pose d&#x27;une semaine si c&#x27;est possible.</em></div><span class="heure">08:40</span></div><div class="statut"><p class="titre">Je prépare la réponse</p><div class="cv-reflexion"><div class="cv-pas" style="--i:0"><span class="cv-etat"><span class="rond"></span><svg class="coche" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="var(--accent-soft)"></circle><path d="m5 8.2 2.2 2.2L11 6.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><div><b>Vos fiches clients</b><i>chantier en cours depuis mars</i></div></div><div class="cv-pas" style="--i:1"><span class="cv-etat"><span class="rond"></span><svg class="coche" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="var(--accent-soft)"></circle><path d="m5 8.2 2.2 2.2L11 6.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><div><b>Votre planning</b><i>jeudi 25 à 9 h, créneau libre</i></div></div></div></div><div class="ligne pale"><span class="pastille"></span><div><b>Fournisseur Delmas</b><i>Confirmation de commande</i></div><span class="heure">08:05</span></div><div class="ligne pale"><span class="pastille"></span><div><b>Assurance Pro</b><i>Votre échéance annuelle</i></div><span class="heure">hier</span></div><div class="ligne pale"><span class="pastille"></span><div><b>Salon du bâtiment</b><i>Invitation — 12 novembre</i></div><span class="heure">mardi</span></div><div class="fenetre"><div class="entete">Nouveau message<span class="croix">✕</span></div><div class="champs"><span class="champ">À : M. Bonnet</span><span class="champ">Objet : Rendez-vous à confirmer</span><p class="corps">jeudi 25, 9 h · le créneau est libre</p></div><div class="pied"><span class="cv-bouton">Confirmer</span><span class="jetable">Modifier avant envoi</span></div></div></div></div></div>

    <!-- Le téléphone : une question de gestion posée par un salarié, la réponse arrive en notification. -->
    <div class="cv-scene tel" data-ecran="2" data-etape="4"><div class="etat"><span>9:41</span><span class="voyants"><svg viewBox="0 0 24 10" fill="none"><rect x="0" y="6" width="2.4" height="4" rx="1" fill="currentColor"></rect><rect x="3.6" y="4" width="2.4" height="6" rx="1" fill="currentColor"></rect><rect x="7.2" y="2" width="2.4" height="8" rx="1" fill="currentColor"></rect><rect x="10.8" y="0" width="2.4" height="10" rx="1" fill="currentColor"></rect><rect x="16" y="1.5" width="7" height="7" rx="2" stroke="currentColor" stroke-width="1.2"></rect></svg></span></div><div class="cv-corps"><div class="cv-vue vue" data-c="2"><div class="banniere"><span class="tuile">S</span><div><b>Louis, atelier<span class="quand">maintenant</span></b><p>On est sur un bon trimestre, ou pas ?</p></div></div><div class="feuille"><span class="poignee"></span><div class="encours"><p class="titre">Je me connecte à vos outils…</p><div class="cv-reflexion"><div class="cv-pas" style="--i:0"><span class="cv-etat"><span class="rond"></span><svg class="coche" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="var(--accent-soft)"></circle><path d="m5 8.2 2.2 2.2L11 6.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><div><b>Votre comptabilité</b><i>chiffre du trimestre relevé</i></div></div><div class="cv-pas" style="--i:1"><span class="cv-etat"><span class="rond"></span><svg class="coche" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="var(--accent-soft)"></circle><path d="m5 8.2 2.2 2.2L11 6.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path></svg></span><div><b>Votre planning</b><i>14 chantiers livrés</i></div></div></div></div><div class="resultat"><b>Synthèse du trimestre</b><i>chiffres et chantiers comparés au trimestre passé</i><div class="reglages"><span>Demande de<em>Louis, atelier</em></span><span>Préparé avec<em>Votre comptabilité · Votre planning</em></span></div><span class="cv-bouton plein">Ouvrir</span><span class="secondaire">Plus tard</span></div></div></div></div><span class="accueil"></span></div>

