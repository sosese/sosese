---
import Card from "../ui/Card.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Figure from "../ui/diagrams/Figure.astro";

// C8 : lieu canonique de la promesse de validation humaine. Elle ne doit plus être réénoncée ailleurs
// sur l'accueil (B8) — le bandeau d'engagements, la carte sur-mesure et « Sous le capot » l'ont perdue.
const libre = ["lire les demandes qui arrivent", "chercher dans vos dossiers", "calculer un prix sur vos tarifs", "préparer le brouillon"];
const accord = ["envoyer un message à un client", "créer un devis dans votre logiciel", "modifier une fiche", "engager un prix"];

// Quatre cartes, pas cinq : la grille `lg:grid-cols-4` ne tient qu'à quatre. « Aucun entraînement »
// rejoint la carte mémoire (on scanne les titres, c'est donc le titre qui doit porter les deux), « code »
// et « réversibilité » fusionnent, et la place libérée accueille le périmètre d'accès (2026-09-19).
const engagements = [
  {
    titre: "Rien de mémorisé, rien qui serve à entraîner l'IA",
    texte: "La tâche finie, il ne reste rien. Ce qu'elle retient — vos règles, vos préférences — c'est vous qui le décidez, et vous pouvez l'effacer.",
    icone: '<path d="M12 3 5 6v5c0 4.5 3 8.5 7 10 4-1.5 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>',
  },
  {
    titre: "Elle ne consulte que ce qu'il faut",
    texte: "Pour chaque tâche, on écrit noir sur blanc à quelles données elle a accès. Le reste de vos dossiers, elle ne l'ouvre pas.",
    icone: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/><path d="m9 13 2 2 4-4"/>',
  },
  {
    titre: "Vos données ne quittent pas l'Europe",
    texte: "Elles sont traitées et stockées dans l'Union européenne, chez des hébergeurs qu'on vous nomme.",
    icone: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
  },
  {
    titre: "Vous pouvez reprendre la main",
    texte: "Le code, les comptes et les accès sont à votre nom, et le mode d'emploi est livré avec. Votre équipe, ou quelqu'un d'autre, peut prendre la suite.",
    icone: '<path d="M4 9h13l-3-3M20 15H7l3 3"/>',
  },
];
---

<section id="confiance" aria-labelledby="confiance-titre" class="py-(--section-y)">
  <div class="container-site flex flex-col gap-12">
    <SectionHeading id="confiance-titre" eyebrow="Confiance & données" title="Vos données restent les vôtres">
      Elle lit ce qu'il faut. Elle n'en garde rien. Elle n'envoie rien sans vous.
    </SectionHeading>

    <Figure label="Qui décide quoi" caption="La même règle vaut pour tout ce que nous construisons.">
      <div class="grid items-stretch gap-3 lg:grid-cols-[1fr_auto_1fr]">
        <div class="flex flex-col gap-5 rounded-lg border border-border bg-surface p-6">
          <p class="text-18 font-semibold text-ink">Elle avance seule</p>
          <ul class="flex flex-col gap-3 text-16 text-ink-muted">
            {
              libre.map((item) => (
                <li class="flex items-start gap-3">
                  <svg aria-hidden="true" viewBox="0 0 24 24" class="mt-1 size-4 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m5 13 4 4L19 7" />
                  </svg>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        {/* La porte, et le seul aplat de couleur de la section : c'est là que tout s'arrête. */}
        <div aria-hidden="true" class="flex flex-col items-center justify-center gap-2 py-1 lg:flex-row lg:px-3 lg:py-0">
          <span class="h-5 w-px bg-border-strong lg:h-px lg:w-5"></span>
          <span class="rounded-full bg-accent px-4 py-1.5 font-mono text-12 font-semibold tracking-wide whitespace-nowrap text-on-accent uppercase">
            votre oui
          </span>
          <span class="h-5 w-px bg-border-strong lg:h-px lg:w-5"></span>
        </div>

        <div class="flex flex-col gap-5 rounded-lg border border-accent bg-surface p-6">
          <p class="text-18 font-semibold text-ink">Elle s'arrête net</p>
          <ul class="flex flex-col gap-3 text-16 text-ink">
            {
              accord.map((item) => (
                <li class="flex items-start gap-3">
                  <svg aria-hidden="true" viewBox="0 0 24 24" class="mt-1 size-4 shrink-0 text-accent" fill="currentColor">
                    <rect x="7" y="5" width="4" height="14" rx="1.5" />
                    <rect x="13" y="5" width="4" height="14" rx="1.5" />
                  </svg>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </Figure>

    <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        engagements.map((e) => (
          <li class="flex">
            <Card interactive class="flex w-full flex-col gap-4">
              <span class="flex size-10 items-center justify-center rounded-md bg-accent-soft text-accent">
                <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={e.icone} />
              </span>
              <h3 class="text-18 font-semibold">{e.titre}</h3>
              <p class="text-14 text-ink-muted">{e.texte}</p>
            </Card>
          </li>
        ))
      }
    </ul>
  </div>
</section>
