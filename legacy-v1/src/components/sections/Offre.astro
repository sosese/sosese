---
import RotationEcrans from "../ui/diagrams/RotationEcrans.astro";
import SectionHeading from "../ui/SectionHeading.astro";

// Une seule offre depuis le 2026-09-17 : « Audit & diagnostic » et « Ateliers & acculturation »
// répétaient les étapes 1 et 2 de la Méthode, juste au-dessus. La grille bento a disparu avec elles.
//
// Ce que change une solution sur-mesure. Aucune promesse chiffrée ici : ce sont des principes de
// fonctionnement, cohérents avec les engagements (aucune écriture sans accord, code et données remis).
//
// `icone` : tracé SVG en ligne, chaîne statique (même contrat que la section Confiance — jamais de
// `set:html` sur du contenu éditable). Décoratif : l'argument est déjà écrit à côté.
//
// « elle » : la solution est nommée une fois dans le chapeau ci-dessous, puis reprise en « elle » ici et
// dans la section Confiance. Ne jamais employer le pronom avant ce chapeau — plus haut dans la page, il
// n'a pas d'antécédent (voir DESIGN.md, « Copy »).
const arguments_ = [
  {
    // Des lignes de tâches, dont une est barrée : ce qui disparaît, ce sont les tâches, pas les outils.
    icone: '<path d="M4 6h13M4 11h9M4 16h5"/><path d="m11 13 6 6M17 13l-6 6"/>',
    titre: "L'administratif en moins, pas un outil en plus.",
    texte: "Les saisies, les recopies, les relances : ce qui prend du temps sans rien rapporter part en premier. Vos équipes gardent leurs logiciels et leurs habitudes.",
  },
  {
    // Des données empilées d'où repart une flèche : ce qui dort se remet en mouvement.
    icone: '<ellipse cx="9" cy="6" rx="5" ry="2.5"/><path d="M4 6v6c0 1.4 2.2 2.5 5 2.5s5-1.1 5-2.5V6"/><path d="M4 12v6c0 1.4 2.2 2.5 5 2.5"/><path d="M14 18h6m-3-3 3 3-3 3"/>',
    titre: "Vos informations enfin réunies.",
    texte: "Vos devis, vos mails, vos tableurs, votre logiciel de gestion : elle va chercher au bon endroit, dans tous vos outils à la fois.",
  },
  {
    // Une horloge : elle part toute seule, à l'heure ou au seuil que vous avez fixés.
    icone: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
    titre: "Elle prend les devants.",
    texte: "Le devis qui dort depuis dix jours, la relance à envoyer : c'est préparé quand vous arrivez. Vous réglez ce qui la déclenche.",
  },
  {
    // Des curseurs de réglage : c'est vous qui tenez les manettes, et vous les déplacez quand il faut.
    icone: '<path d="M4 6h8M17 6h3M4 12h3M12 12h8M4 18h8M17 18h3"/><circle cx="14.5" cy="6" r="2.5"/><circle cx="9.5" cy="12" r="2.5"/><circle cx="14.5" cy="18" r="2.5"/>',
    // Règles ≠ données : sans cette distinction, « elle retient vos corrections » contredit « rien n'est
    // mémorisé par défaut » (bandeau et section Confiance). Les deux objets sont nommés séparément.
    titre: "Elle garde vos règles, pas vos données.",
    texte: "Vos corrections deviennent des règles de travail : votre façon de rédiger, vos remises, vos exceptions. Ce sont ces règles qu'elle garde — jamais les documents qu'elle a lus.",
  },
];
---

<section id="offre" aria-labelledby="offre-titre" class="py-(--section-y)">
  <div class="container-site flex flex-col gap-12">
    <SectionHeading id="offre-titre" eyebrow="Ce qu'on construit" title="Une solution construite pour vous, qui travaille comme vous">
      Pas un logiciel de plus à apprendre : une solution qui connaît vos prix, vos dossiers et votre façon de
      travailler. Elle prépare le travail, vous gardez la main.
    </SectionHeading>

    {/* Piste de droite en **21rem**, et non `auto` : `auto` se cale sur le max-content de la
        maquette — c'est-à-dire sur sa barre de libellés, ~21 rem — et lui donner une `max-width`
        plus large n'y change rien (plancher : 21 rem, la largeur la plus étroite où la barre des
        quatre décors tient encore sur une ligne). La colonne de texte prend le reste, et les deux
        passent l'une sous l'autre avant lg.
        L'écart entre arguments est **fixe** (`lg:gap-16`, 64 px) et non réparti sur la hauteur :
        `justify-between` les espaçait de 90 px, soit une ligne de corps de trop. La liste est donc
        un peu plus courte que la maquette, et `lg:items-center` la centre en face d'elle. */}
    <div class="grid items-start gap-12 lg:grid-cols-[1fr_24rem] lg:items-center lg:gap-16">
      <div class="flex flex-col">
        <ul class="flex max-w-(--measure) flex-col gap-6 text-16 text-ink-muted lg:gap-16">
          {
            arguments_.map((a) => (
              <li class="flex gap-4">
                <span class="flex size-9 shrink-0 items-center justify-center rounded-md bg-accent-soft text-accent">
                  <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={a.icone} />
                </span>
                <p>
                  <strong class="font-medium text-ink">{a.titre}</strong> {a.texte}
                </p>
              </li>
            ))
          }
        </ul>
      </div>

      {/* La rotation d'écrans, descendue du hero le 2026-09-19 : c'est ici, en face des arguments,
          qu'elle prouve « pas un logiciel de plus » — le même enchaînement arrive dans la
          messagerie, la boîte mail, le téléphone, l'application de gestion. Elle y remplace
          `DicteeMobile`, sans emploi depuis. */}
      <div class="flex w-full flex-col gap-3 justify-self-center lg:justify-self-end">
        <p class="eyebrow">là où vous travaillez déjà</p>
        <RotationEcrans />
      </div>
    </div>
  </div>
</section>
